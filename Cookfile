# ayeaye - the gates a release has to pass, and the artifacts it needs.
#
#   cook test      the Rust suite, lint, and release gates
#   cook bump vX   move the version everywhere it is written down
#   cook dist      build the release tarball and its checksums
#   cook publish   tag and upload it  (refuses a dirty tree)
#
# The version lives in Cargo.toml's [workspace.package], and
# `release-version` fails if this file or the lockfile has drifted from it,
# or the README stops naming the one-liner. `cook bump` moves every one of
# those claims together. The installer claims nothing: it is a downloader
# that fetches the newest release and verifies it against the SHA256SUMS
# published beside it (AYEAYE-63), so there is no stamp step any more.
#
# Cutting a release is one commit:
#
#   cook bump v0.3.1    then commit and push
#   cook dist
#   cook publish v0.3.1
#
# The tag lands on that commit: the artifact is archived from it, and publish
# reads the commit back out of the tarball and tags exactly that. The release
# workflow then builds the per-platform binaries on the tag and publishes
# SHA256SUMS over every uploaded name.

# --- determinants -------------------------------------------------------

probe fixtures
    files { "tests/fixtures/*/*" }

# The artifact is `git archive HEAD`, so its determinant is the commit, not the
# working tree. Sealing it on file contents looked right and was not: adding
# a tracked file leaves every sealed path untouched, so the tarball stayed
# cached while the tree it claimed to hold had changed underneath it.
probe commit
    { git rev-parse HEAD }

# The release scripts are how the artifacts get made, so a changed script must
# remake them: without this, an edited release-archive.sh replays yesterday's
# tarball out of the store and the edit looks like it did nothing.
probe scripts
    files { "scripts/*.sh" }

# Every input to `cargo test --workspace`. cargo iterates the workspace, not a
# file list, so none of this appears on the command line and nothing else would
# tell cook the answer had changed. The lockfile is in here because the suite
# runs `--locked`: a moved dependency is a different answer.
#
# Every `.rs` under crates/, not a list of the directories anyone thought of.
# The first version of this named src/ and tests/ and build.rs, and so went
# green on a planted violation in benches/ that `cargo test` had already gone
# red on - a stale pass on the release gate, from a probe that had quietly
# stopped describing its own recipe. `constitution` asserts the other half of
# this: that every workspace member really does live under crates/.
#
# `share/*` too: the web UI is compiled in with `include_bytes!`, so those
# files are inputs to the suite that live outside crates/. Mutation-verified.
#
# And not only the .rs: a fixture reaches a pure crate through `include_str!`,
# so the expected values of a test can live in a .txt that no glob over source
# would notice. Editing one changes what the suite asserts while leaving every
# sealed path untouched - a cached pass over assertions that have moved, which
# is the same stale green the benches/ omission produced.
#
# The waiver file is the same shape again: the duplication gate reads
# crates/constitution/waivers.toml through `include_str!`, so deleting an
# entry - the ratchet's whole verb - changes what the suite refuses while
# matching no glob here. Named explicitly or the ratchet only turns when a
# .rs file happens to move with it.
probe rust
    files { "Cargo.toml" "Cargo.lock" "crates/*/*.rs" "crates/**/*.rs" "crates/*/Cargo.toml" "share/*" "crates/**/tests/fixtures/*" "crates/constitution/waivers.toml" }

# The compiler is a determinant of what the suite says: a lint that fires on
# one toolchain and not the next is exactly the drift `-D warnings` exists to
# catch, and a cached green from the old one would hide it.
#
# It is the compiler's *version* that is folded, not the binary's bytes. Under
# rustup, `cargo`, `rustc` and `cargo-clippy` are all the same shim - one hash
# for all three, unmoved by the update that replaces the toolchain behind it -
# so `tools { }` alone reports agreement it has not checked.
probe rust:toolchain
    { rustc --version --verbose && cargo clippy --version }

probe rust:tools
    tools { cargo rustc cargo-clippy }

# --- the suite ----------------------------------------------------------
# The Rust workspace is one unit, not one per crate: cargo already builds the
# whole graph to test any part of it, so fanning out would compile the same
# crates several times over and cache none of it better.
#
# The ingredient is the workspace manifest - a source, which is what makes this
# cacheable at all. The sources themselves are the sealed probe above: cargo
# consumes them, but it does not take them as arguments.
#
# `fixtures` is sealed because Rust tests read captured unit and probe fixtures
# through `include_str!`, so a golden file
# is an input to `cargo test` that appears on no command line and that the
# `rust` probe - a glob under crates/ - cannot see. Without it, editing a
# fixture leaves the release gate replaying a cached green over a corpus that
# moved.

recipe rust-suite
    ingredients "Cargo.toml"
    seal rust
    seal rust:toolchain
    seal rust:tools
    seal fixtures
    test { cargo test --workspace --locked }

# Separate from the suite so a lint failure and a test failure are two
# different red units rather than one. `-D warnings` is the gate the milestone
# asked for; without it clippy is advice nobody reads.
# `fixtures` for the same reason as above: --all-targets compiles the tests, and
# the tests `include_str!` the captured units.
recipe rust-lint
    ingredients "Cargo.toml"
    seal rust
    seal rust:toolchain
    seal rust:tools
    seal fixtures
    test { cargo clippy --workspace --all-targets --locked -- -D warnings }

# --- release gates ------------------------------------------------------

# The gate reads the crate manifest and its lockfile as version claims, so
# they must reseal it: without this, a drifted Cargo.toml would replay the
# cached green from before the drift.
probe manifest
    files { "Cargo.toml" "Cargo.lock" }

recipe release-version
    ingredients "scripts/check-release-version.sh"
    seal scripts
    seal manifest
    test { bash scripts/check-release-version.sh v0.3.1 }

# --- the artifacts ------------------------------------------------------
# Gated on the Rust checks: a red test blocks the tarball rather than shipping it.
# Sealed on the sources because `git archive` names none of them, so nothing
# else would tell cook the artifact is stale.

recipe dist: release-version rust-suite rust-lint
    seal commit
    seal scripts
    cook "dist/ayeaye-v0.3.1.tar.gz" { bash scripts/release-archive.sh $<out> }
    cook "dist/SHA256SUMS" { bash scripts/release-checksums.sh $<in> $<out> }

# No source, so it always runs: the question is not "did the inputs change"
# but "is the thing on disk right now something the bootstrap can install".
recipe release-installable: dist
    test { bash scripts/check-release-artifact.sh dist/ayeaye-v0.3.1.tar.gz }

# --- publishing ---------------------------------------------------------
# A chore, not a recipe: it talks to GitHub, and `cook test` must never
# reach it.

# Deliberately not depending on dist: publish takes the artifact on disk and
# proves it reproducible from the commit named inside it, so a stale or
# hand-built tarball is refused rather than silently rebuilt. The Rust and
# version gates still stand in the way of a red tree.
chore publish version="v0.3.1": release-version rust-suite rust-lint
    bash scripts/release-publish.sh $<version>

chore bump version
    bash scripts/release-bump.sh $<version>

chore clean
    rm -rf dist
