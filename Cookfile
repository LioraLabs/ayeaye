# ayeaye - the gates a release has to pass, and the artifacts it needs.
#
#   cook test      every test file as its own cached unit, plus the release gates
#   cook bump vX   move the version everywhere it is written down
#   cook dist      build the release tarball and its checksums
#   cook stamp     write the artifact's checksum into install.sh
#   cook publish   tag and upload it  (refuses a dirty tree)
#
# The version lives in exactly one place - AYEAYE_VERSION at the top of
# install.sh - and `release-version` fails if this file or anything else has
# drifted from it.
#
# Cutting a release is two commits, in this order:
#
#   cook bump v0.2.2    then commit           (the build commit)
#   cook dist
#   cook stamp          then commit and push  (the stamp commit)
#   cook publish v0.2.2
#
# The tag lands on the build commit, not the stamp commit: the artifact is
# archived from it, and publish reads that commit back out of the tarball and
# tags exactly that. The stamped install.sh on main then verifies the artifact
# built one commit before it - which is the design, not an accident of order;
# a checksum cannot describe the very commit it is written into.

# --- determinants -------------------------------------------------------
# What changes a test's answer without ever appearing on its command line.
# These are sealed rather than listed as ingredients: the test harness
# iterates case files, it does not iterate the wizard it is testing.

probe wizard
    files { "install.sh" "lib/*.sh" "lib/steps/*.sh" }

probe app
    files { "bin/ayeaye" "bin/voice-dictate" "bin/voice-agent" "bin/voice-dictate-setup" "bin/process_inspect.py" }

probe harness
    files { "tests/run.sh" "tests/lib/*" "tests/python/*" }

probe fixtures
    files { "tests/fixtures/*/*" }

# The artifact is `git archive HEAD`, so its determinant is the commit, not the
# working tree. Sealing it on file contents looked right and was not: adding
# a tracked file leaves every sealed path untouched, so the tarball stayed
# cached while the tree it claimed to hold had changed underneath it.
probe commit
    { git rev-parse HEAD }

# The release scripts are how the artifacts get made, so a changed script must
# remake them: without this, an edited release-archive.sh replays yesterday's
# tarball out of the store and the edit looks like it did nothing.
probe scripts
    files { "scripts/*.sh" }

# Every input to `cargo test --workspace`. cargo iterates the workspace, not a
# file list, so none of this appears on the command line and nothing else would
# tell cook the answer had changed. The lockfile is in here because the suite
# runs `--locked`: a moved dependency is a different answer.
probe rust
    files { "Cargo.toml" "Cargo.lock" "crates/*/Cargo.toml" "crates/*/build.rs" "crates/*/src/*.rs" "crates/*/src/**/*.rs" "crates/*/tests/*.rs" "crates/*/tests/**/*.rs" }

# The compiler is a determinant of what the suite says: a lint that fires on
# one toolchain and not the next is exactly the drift `-D warnings` exists to
# catch, and a cached green from the old one would hide it.
probe rust:tools
    tools { cargo rustc cargo-clippy }

# --- the suite ----------------------------------------------------------
# One unit per case file, so editing one test re-runs one test. The whole
# suite is ~7.5 minutes serially; fanned out it is bounded by the slowest
# single file, and an edit costs only that file.

recipe suite
    ingredients "tests/cases/*_test.sh"
    seal wizard
    seal app
    seal harness
    seal fixtures
    seal scripts
    test { bash tests/run.sh $<in.stem> }

# The Rust workspace is one unit, not one per crate: cargo already builds the
# whole graph to test any part of it, so fanning out would compile the same
# crates several times over and cache none of it better. It is its own unit
# rather than a step inside the bash suite so that an edit to a shell test does
# not recompile Rust, and an edit to Rust does not re-run 69 shell files.
#
# The ingredient is the workspace manifest - a source, which is what makes this
# cacheable at all. The sources themselves are the sealed probe above: cargo
# consumes them, but it does not take them as arguments.

recipe rust-suite
    ingredients "Cargo.toml"
    seal rust
    seal rust:tools
    test { cargo test --workspace --locked }

# Separate from the suite so a lint failure and a test failure are two
# different red units rather than one. `-D warnings` is the gate the milestone
# asked for; without it clippy is advice nobody reads.
recipe rust-lint
    ingredients "Cargo.toml"
    seal rust
    seal rust:tools
    test { cargo clippy --workspace --all-targets --locked -- -D warnings }

# --- release gates ------------------------------------------------------

recipe release-version
    ingredients "scripts/check-release-version.sh"
    seal wizard
    seal scripts
    test { bash scripts/check-release-version.sh v0.2.2 }

# --- the artifacts ------------------------------------------------------
# Gated on the suite: a red test blocks the tarball rather than shipping it.
# Sealed on the sources because `git archive` names none of them, so nothing
# else would tell cook the artifact is stale.

recipe dist: suite release-version rust-suite rust-lint
    seal commit
    seal scripts
    cook "dist/ayeaye-v0.2.2.tar.gz" { bash scripts/release-archive.sh $<out> }
    cook "dist/SHA256SUMS" { bash scripts/release-checksums.sh $<in> $<out> }

# No source, so it always runs: the question is not "did the inputs change"
# but "is the thing on disk right now something the bootstrap can install".
recipe release-installable: dist
    test { bash scripts/check-release-artifact.sh dist/ayeaye-v0.2.2.tar.gz }

# --- publishing ---------------------------------------------------------
# Chores, not recipes: they mutate a tracked file and talk to GitHub, and
# neither belongs in `cook test`.

chore stamp: dist
    bash scripts/release-stamp.sh dist/SHA256SUMS install.sh

# Deliberately not depending on dist: dist is sealed on the commit, and the
# stamp commit moves it, so a publish that rebuilt dist would upload a tarball
# the stamp in install.sh does not describe. Publish takes the artifact on
# disk and verifies it against the stamp itself; the suite and version gates
# still stand in the way of a red tree. The dirty-tree refusal lives in the
# script, which can tell an uncommitted stamp from ordinary dirt and say
# "commit it and go" rather than only "no".
chore publish version="v0.2.2": suite release-version rust-suite rust-lint
    bash scripts/release-publish.sh $<version>

chore bump version
    bash scripts/release-bump.sh $<version>

chore clean
    rm -rf dist
