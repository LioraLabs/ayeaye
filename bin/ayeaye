#!/usr/bin/env python3
"""Voice remote for tmux: a phone-shaped web UI over capture-pane/send-keys.

Serves a small page that lists your panes, shows what each is doing, and lets
you talk into whichever one you pick. The browser does the recording, so a
phone needs nothing installed -- no Termux, no daemon, no wake lock.

Bound to loopback on purpose. Put it on the tailnet with:

    tailscale serve --bg --https 443 http://127.0.0.1:8911

which also gives it a real certificate, and browsers only allow microphone
access from a secure origin.
"""
import glob
import hmac
import http.cookies
import json
import os
import re
import secrets
import shlex
import shutil
import socket
import subprocess
import threading
import sys
import time
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_file_location


def _load_sibling(name, filename):
    """A python file next to this command, loaded as a module.

    Loaded rather than imported because bin/ holds commands: they have no .py
    extension, they are not on any import path, and there is no package here
    and no intention of adding one. The same few lines appear in
    bin/voice-dictate; that is the price of having no package, and it is
    cheaper than the packaging that would remove it.

    realpath, not abspath. These get symlinked onto PATH -- that is the
    documented way to run them -- and abspath would resolve "next to" as next
    to the symlink, where there is nothing. It would fail at import, before
    anything could say so.

    sys.modules is consulted first because this command loads bin/voice-dictate
    and both of them load bin/process_inspect.py. Loading that twice would give
    the two of them separate class objects and a PROCESS_INFO each -- the same
    divergence the shared module exists to prevent, arriving one process later.

    Registered before it is executed, which is what lets a module load its own
    sibling, and removed again if the body raises -- otherwise the next caller
    is handed a half-built module instead of an error.
    """
    if name in sys.modules:
        return sys.modules[name]
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), filename)
    # The loader is named rather than inferred: importlib picks one from the
    # file extension, and a command deliberately has none.
    spec = spec_from_file_location(name, path,
                                   loader=SourceFileLoader(name, path))
    module = module_from_spec(spec)
    sys.modules[name] = module
    try:
        spec.loader.exec_module(module)
    except BaseException:
        del sys.modules[name]
        raise
    return module


def _load_env_file():
    """Fill os.environ from the install.sh config file.

    One file serves both entry points: systemd user units read it through
    EnvironmentFile=, and a bare `bin/ayeaye` picks it up here. A
    variable already present in the environment always wins, so unit-level
    settings and one-off overrides behave as expected. Values are literal:
    no shell expansion, matching how systemd reads the same file.
    """
    base = (os.environ.get("XDG_CONFIG_HOME")
            or os.path.expanduser("~/.config"))
    lines = None
    for name in ("ayeaye", "voice-remote"):     # new name first, legacy second
        try:
            with open(os.path.join(base, name, "env")) as fh:
                lines = fh.readlines()
            break
        except OSError:
            continue
    if lines is None:
        return
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        key, sep, val = line.partition("=")
        key = key.strip()
        if sep and key and key not in os.environ:
            os.environ[key] = val.strip().strip('"').strip("'")


_load_env_file()


def _env(name, default=""):
    """AYEAYE_<name>, falling back to the legacy VOICE_REMOTE_<name>."""
    return os.environ.get("AYEAYE_" + name,
                          os.environ.get("VOICE_REMOTE_" + name, default))


def _state_dir():
    """State under ayeaye/, but an existing legacy dir keeps working."""
    state = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    new, old = os.path.join(state, "ayeaye"), os.path.join(state, "voice-remote")
    return old if (os.path.isdir(old) and not os.path.isdir(new)) else new

# Reuse the pipeline rather than reimplementing it: same whisper server, same
# rewrite model, same silence gate, same log. Imported after the env file is
# loaded, because voice-dictate reads its configuration at import time.
vd = _load_sibling("voice_dictate", "voice-dictate")

# The UI ships in share/ next to bin/, so a fresh clone serves straight from
# the repo. A ~/.local/share install (the old symlink layout) still wins when
# it exists; VOICE_REMOTE_SHARE overrides both.
_LOCAL_SHARE = next((p for p in (os.path.expanduser("~/.local/share/ayeaye"),
                                 os.path.expanduser("~/.local/share/voice-remote"))
                     if os.path.exists(os.path.join(p, "app.html"))),
                    os.path.expanduser("~/.local/share/ayeaye"))
_REPO_SHARE = os.path.join(
    os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "share")
SHARE_DIR = (_env("SHARE", None)
             or (_LOCAL_SHARE
                 if os.path.exists(os.path.join(_LOCAL_SHARE, "app.html"))
                 else _REPO_SHARE))
APP_HTML = os.path.join(SHARE_DIR, "app.html")
BOARD_HTML = os.path.join(SHARE_DIR, "board.html")
MANIFEST = os.path.join(SHARE_DIR, "manifest.webmanifest")
ICON_SVG = os.path.join(SHARE_DIR, "icon.svg")
BIND = _env("BIND", "127.0.0.1")
PORT = int(_env("PORT", "8911"))
PANE_LINES = int(_env("LINES", "24"))
# Display name for the "host" field of /api/panes and /api/overview.
# Overridable so screenshots need not reveal the machine's real hostname.
HOST_NAME = _env("NAME").strip() or os.uname().nodename
# Gap between typing text and pressing Enter. See /api/send.
SEND_ENTER_DELAY = float(os.environ.get("VOICE_SEND_DELAY", "0.4"))

# Push notifications. Empty disables the watcher entirely -- the app works
# without it, this only saves you from having to look.
NTFY_URL = os.environ.get("VOICE_NTFY_URL", "")
NTFY_CLICK = os.environ.get("VOICE_NTFY_CLICK", "")   # opened when tapped
NOTIFY_EVERY = int(os.environ.get("VOICE_NOTIFY_EVERY", "10"))
# Which states are worth a notification. "blocked" is an agent stopped at a
# prompt. "waiting" fires after every completed turn, which is constant for an
# active agent, so it is off unless you ask for it.
NOTIFY_STATES = set(filter(None, os.environ.get(
    "VOICE_NOTIFY_STATES", "blocked").split(",")))


# ---------------------------------------------------------------------- auth
# Network placement (tailnet, loopback) is the front door, but it is not
# sufficient on its own: every peer on the tailnet would otherwise hold what
# amounts to shell access. So every /api/* request must present a shared
# secret -- as an X-Voice-Token header, or as the voice_token cookie that
# /login sets so a phone browser only ever types the token once.

def _load_token():
    """The shared secret: AYEAYE_TOKEN (legacy VOICE_REMOTE_TOKEN), else a state file, generated
    0600 on first run so the app is never accidentally open."""
    tok = _env("TOKEN").strip()
    if tok:
        return tok
    path = os.path.join(_state_dir(), "token")
    try:
        with open(path) as fh:
            tok = fh.read().strip()
        if tok:
            return tok
    except OSError:
        pass
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tok = secrets.token_urlsafe(32)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(tok + "\n")
    sys.stderr.write("generated auth token at %s\n" % path)
    return tok


TOKEN = _load_token()


def _allowed_hosts():
    """Host values a request may carry. Defeats DNS rebinding: a page on an
    attacker's origin resolving their hostname to this address still sends
    their Host header, which is not in this set.

    Defaults cover direct access to the bind address; anything fronting this
    (tailscale serve, a reverse proxy) presents its own Host and must be
    listed in AYEAYE_ALLOWED_HOSTS (or the legacy VOICE_REMOTE_ prefix).
    """
    hosts = set()
    for h in (BIND, "localhost", "127.0.0.1"):
        hosts.add(h.lower())
        hosts.add("%s:%d" % (h.lower(), PORT))
    for h in _env("ALLOWED_HOSTS").split(","):
        h = h.strip().lower().rstrip("/")
        if h:
            hosts.add(h)
    return hosts


ALLOWED_HOSTS = _allowed_hosts()

# Request body caps. Dictation audio is real data (a couple of minutes of
# webm); nothing else the API accepts has any business being large.
MAX_BODY = 1 << 20            # 1 MB for JSON endpoints
MAX_AUDIO_BODY = 32 << 20     # 32 MB for /api/dictate
AUDIO_EXTS = {"webm", "ogg", "mp4", "wav", "m4a"}


def tmux(*args):
    try:
        return subprocess.run(("tmux",) + args, capture_output=True,
                              text=True, timeout=5).stdout
    except Exception:
        return ""


def list_panes():
    fmt = ("#{pane_id}\t#{session_name}\t#{window_index}\t#{window_name}"
           "\t#{pane_current_command}\t#{?pane_active,1,0}")
    out = []
    for line in tmux("list-panes", "-a", "-F", fmt).splitlines():
        parts = line.split("\t")
        if len(parts) != 6:
            continue
        pid, sess, widx, wname, cmd, active = parts
        if sess.startswith("_"):        # floating scratch panes; not targets
            continue
        out.append({"id": pid, "session": sess, "window": widx,
                    "name": wname, "cmd": cmd, "active": active == "1"})
    return out


# Written by ~/.claude/statusline-command.sh. The pane is the only thing this
# server can see, so the session announces itself there rather than us guessing
# from cwd and mtime -- which is ambiguous the moment two agents share a repo.
CLAUDE_MARKER = re.compile(r"⟪ cc:([0-9a-f]{8})⟫".replace(" ", ""))
CLAUDE_PROJECTS = os.path.expanduser("~/.claude/projects")
CODEX_SESSIONS = os.path.expanduser("~/.codex/sessions")


def pane_session(pane_id):
    """Which agent transcript belongs to this pane, if any."""
    text = tmux("capture-pane", "-p", "-t", pane_id, "-S", "-200")

    m = CLAUDE_MARKER.search(text)
    if m:
        hit = glob.glob(os.path.join(CLAUDE_PROJECTS, "*", m.group(1) + "*.jsonl"))
        if hit:
            return {"kind": "claude", "id": m.group(1), "path": hit[0]}

    # Codex has no statusline hook to carry a marker, so fall back to matching
    # the pane's directory against the cwd recorded in each rollout's
    # session_meta, newest first.
    cmd = tmux("display-message", "-p", "-t", pane_id, "#{pane_current_command}").strip()
    if cmd == "codex":
        pane_pid = tmux("display-message", "-p", "-t", pane_id, "#{pane_pid}").strip()
        return codex_session_for(pane_pid)
    return None


# ---------------------------------------------------------- process lookup
# Which agent is behind a pane is a platform question, and it is answered in
# bin/process_inspect.py rather than here, because bin/voice-dictate has to
# ask the same one about tmux clients. See that file for why it is a separate
# module and not a paragraph of this one.
#
# PROCESS_INFO is the only one of these this file goes on to use. The rest are
# aliases, and they are here for a reason worth stating rather than left as
# tidy-looking dead weight: the suite that pins this backend addresses it
# through this module, and keeping the names where they have always been is
# what let the extraction land without a single assertion being edited. A
# refactor whose tests had to be rewritten alongside it proves rather less.
process_inspect = _load_sibling("ayeaye_process_inspect", "process_inspect.py")

_run_tool = process_inspect._run_tool
_ProcessInfo = process_inspect._ProcessInfo
_LinuxProcessInfo = process_inspect._LinuxProcessInfo
_DarwinProcessInfo = process_inspect._DarwinProcessInfo
PS_SNAPSHOT = process_inspect.PS_SNAPSHOT
_make_process_info = process_inspect._make_process_info
PROCESS_INFO = process_inspect.PROCESS_INFO


def codex_session_for(pane_pid, proc=None):
    """Match a codex process to its rollout by start time and cwd.

    Codex hooks would be the clean route, but SessionStart never fires in an
    interactive session on 0.145.0 (openai/codex#17532) -- verified with a
    valid regex matcher and trust granted, and SessionEnd is dead too. Nor
    does codex reliably hold the rollout open, so /proc/<pid>/fd is no good.
    What is reliable: a rollout is created within a second or two of the
    process starting, and its filename carries that timestamp. Pair that with
    cwd and two codex agents in one directory stay distinct -- and it works
    however codex was launched, not just from this app.
    """
    proc = proc or PROCESS_INFO
    pid = proc.descendant(pane_pid, "codex")
    if not pid:
        return None
    started = proc.start_time(pid)
    if started is None:
        return None                                # gone before we looked
    cwd = proc.cwd(pid)                            # a second probe on macOS,
    if cwd is None:                                # so only ask if it can help
        return None

    best = None
    for r in glob.glob(os.path.join(CODEX_SESSIONS, "*", "*", "*",
                                    "rollout-*.jsonl")):
        stamp = os.path.basename(r)[8:27]          # rollout-YYYY-MM-DDTHH-MM-SS
        try:
            t = time.mktime(time.strptime(stamp, "%Y-%m-%dT%H-%M-%S"))
        except (ValueError, OverflowError):        # a filename, so: anything
            continue
        delta = t - started
        # A rollout belongs to this process only if it appeared just after it
        # started. Generous upper bound for a slow first turn; small negative
        # tolerance for clock granularity.
        if not (-5 <= delta <= 120):
            continue
        if best is not None and abs(delta) >= abs(best[0]):
            continue
        try:
            with open(r) as fh:
                meta = json.loads(fh.readline()).get("payload", {})
        except Exception:
            continue
        if meta.get("cwd") == cwd:
            best = (delta, r, meta.get("id") or "")
    if not best:
        return None                                # started, nothing written yet
    return {"kind": "codex", "id": best[2][:8], "path": best[1]}


# How many past entries to send when a client attaches. Everything after that
# arrives live.
BACKLOG = int(os.environ.get("VOICE_TX_ROWS", "200"))
MAX_BLOCK = 4000


def _clip(s):
    # Coerce first: these fields come straight from two evolving JSONL formats
    # and turn up as dicts and lists as well as strings.
    if s is None:
        s = ""
    elif not isinstance(s, str):
        try:
            s = json.dumps(s)
        except Exception:
            s = str(s)
    return s if len(s) <= MAX_BLOCK else s[:MAX_BLOCK] + "\n… (%d more chars)" % (
        len(s) - MAX_BLOCK)


def rows_codex(d):
    """Rows for one parsed codex rollout line."""
    p = d.get("payload") or {}
    kind, ts = p.get("type"), (d.get("timestamp") or "")[11:19]
    if kind == "agent_message" and p.get("message"):
        return [("assistant", ts, "codex", p["message"])]
    if kind == "message" and p.get("role") == "user":
        txt = " ".join(c.get("text", "") for c in p.get("content") or []
                       if isinstance(c, dict))
        if txt.strip():
            return [("user", ts, "you", txt)]
    if kind in ("function_call", "custom_tool_call"):
        return [("tool", ts, p.get("name", "tool"), p.get("arguments") or "")]
    if kind in ("function_call_output", "custom_tool_call_output"):
        o = p.get("output")
        if isinstance(o, dict):
            o = o.get("content") or json.dumps(o)
        return [("result", ts, "result", o or "")]
    return []


def rows_claude(d):
    """Rows for one parsed Claude transcript line.

    Only user/assistant lines carry conversation; the rest (mode, ai-title,
    file-history-snapshot, …) is bookkeeping. A `user` line holding
    tool_result blocks is tool output echoed back, not something you typed.
    """
    t = d.get("type")
    if t not in ("user", "assistant") or d.get("isMeta"):
        return []
    ts = (d.get("timestamp") or "")[11:19]
    content = (d.get("message") or {}).get("content")
    if isinstance(content, str):
        return [("user", ts, "you", content)] if content.strip() else []

    out = []
    for b in content or []:
        if not isinstance(b, dict):
            continue
        bt = b.get("type")
        if bt == "text" and b.get("text", "").strip():
            out.append(("assistant" if t == "assistant" else "user", ts,
                        "claude" if t == "assistant" else "you", b["text"]))
        elif bt == "tool_use":
            arg = b.get("input")
            out.append(("tool", ts, b.get("name", "tool"),
                        arg if isinstance(arg, str) else json.dumps(arg)))
        elif bt == "tool_result":
            c = b.get("content")
            if isinstance(c, list):
                c = " ".join(x.get("text", "") for x in c if isinstance(x, dict))
            out.append(("result", ts, "error" if b.get("is_error") else "result",
                        c or ""))
        # `thinking` blocks arrive redacted (signature, empty text) -- nothing
        # worth showing.
    return out


def rows_for(raw, kind):
    """Parse one JSONL line into zero or more display rows."""
    try:
        d = json.loads(raw)
    except Exception:
        return []
    rows = rows_codex(d) if kind == "codex" else rows_claude(d)
    return [{"cls": c, "ts": ts, "label": lb, "text": _clip(tx)}
            for c, ts, lb, tx in rows]


def stream_transcript(wfile, sess, stop_after=None):
    """Server-sent events: backlog first, then whatever lands next.

    Tails by byte offset rather than re-reading, and only advances past the
    last complete newline -- an agent mid-write leaves a partial line, and
    parsing that would drop the event when the rest arrives.
    """
    kind, path = sess["kind"], sess["path"]

    def send(event, payload):
        wfile.write(("event: %s\ndata: %s\n\n"
                     % (event, json.dumps(payload))).encode())
        wfile.flush()

    with open(path, "rb") as fh:
        data = fh.read()
        offset = data.rfind(b"\n") + 1

    backlog = []
    for raw in data[:offset].splitlines():
        backlog.extend(rows_for(raw.decode("utf-8", "replace"), kind))

    send("init", {"kind": kind, "id": sess["id"],
                  "total": len(backlog), "shown": min(len(backlog), BACKLOG)})
    for row in backlog[-BACKLOG:]:
        send("row", row)
    send("ready", {})

    idle = 0
    while stop_after is None or idle < stop_after:
        try:
            size = os.path.getsize(path)
        except OSError:
            break
        if size > offset:
            with open(path, "rb") as fh:
                fh.seek(offset)
                chunk = fh.read(size - offset)
            cut = chunk.rfind(b"\n") + 1
            if cut:
                for raw in chunk[:cut].splitlines():
                    for row in rows_for(raw.decode("utf-8", "replace"), kind):
                        send("row", row)
                offset += cut
            idle = 0
        else:
            idle += 1
            # Comment frame: keeps the connection warm through the proxy and
            # lets the browser notice a dead link rather than hanging forever.
            wfile.write(b": ping\n\n")
            wfile.flush()
        time.sleep(1)


IDLE_AFTER = int(os.environ.get("VOICE_IDLE_AFTER", "300"))   # seconds

# A pending approval lives only in the TUI. Codex logs the exec_command it
# wants to run but never an approval event, so the transcript looks like work
# in progress while the agent is actually stopped dead waiting for you. The
# pane is the only place this is visible.
_OPT = re.compile(r"^\s*[›❯>]?\s*(\d+)\.\s+(.*\S)\s*$")
_CONFIRM = re.compile(r"press enter to confirm|esc to cancel|\(esc\)"
                      r"|enter to select|arrow keys", re.I)
_RULE = re.compile(r"^[─━═\-_╌┈]{8,}$")


def pane_prompt(pane_id, window=30):
    """The question a pane is blocked on, or None.

    Same shape for both agents: numbered options with a selection marker and
    a confirm/escape hint below them.
    """
    lines = [l.rstrip() for l in
             tmux("capture-pane", "-p", "-t", pane_id).splitlines()]
    while lines and not lines[-1].strip():
        lines.pop()                        # trailing blanks hide the block
    tail = lines[-window:]

    idx = [i for i, l in enumerate(tail) if _OPT.match(l)]
    if len(idx) < 2 or not any(_CONFIRM.search(l) for l in tail[idx[0]:]):
        return None
    # The prompt must still be the last thing on screen. Once the agent moves
    # on, its output lands below the old options -- without this, answered
    # prompts keep reporting "blocked" until they scroll away.
    for l in tail[idx[-1] + 1:]:
        if l.strip() and not _CONFIRM.search(l):
            return None
    options = [{"key": _OPT.match(tail[i]).group(1),
                "label": _OPT.match(tail[i]).group(2)[:90]} for i in idx]

    # Blank lines interleave the question block in both agents, so skip them
    # rather than stopping. End at the bullet that starts the agent's turn,
    # or at a rule -- Claude draws one between its prose and the prompt, and
    # without that the walk-back runs on into the startup banner.
    q = []
    for l in reversed(tail[:idx[0]]):
        s = l.strip()
        if not s:
            continue
        if _RULE.match(s):
            break
        q.append(s.lstrip("•·●○◆▪ "))
        if s[0] in "•·●○◆▪" or len(q) >= 8:
            break
    return {"question": " ".join(reversed(q))[:400], "options": options}


# Named keys the remote may press. An allow-list, because this endpoint is
# reachable over the network and must not become a general send-keys hole.
NAV_KEYS = {"enter": "Enter", "esc": "Escape", "up": "Up", "down": "Down",
            "left": "Left", "right": "Right", "tab": "Tab", "space": "Space"}


def answer_prompt(pane_id, key):
    """Press one key in a pane.

    A digit is sent on its own and never with Enter. Claude's multi-select
    uses digits to toggle checkboxes and Enter to submit, so pairing them
    toggled and submitted in a single tap. Codex's approve prompt needs the
    same two steps. Confirming is always explicit -- which is also what you
    want from a remote that can approve `git restore`.
    """
    if key in NAV_KEYS:
        tmux("send-keys", "-t", pane_id, NAV_KEYS[key])
        return {"ok": True, "sent": key}
    if key.isdigit() and 1 <= int(key) <= 9:
        tmux("send-keys", "-t", pane_id, "-l", key)
        return {"ok": True, "sent": key}
    return {"error": "bad key"}


def session_status(sess, tail_bytes=200_000):
    """What is this agent doing right now?

    Derived from the tail of the transcript rather than a hook, so it works
    the same for claude and codex and needs nothing installed. The last row
    type is the tell: an agent that just spoke has handed the turn back;
    one whose last event is a tool call or its result is mid-turn.
    """
    try:
        size = os.path.getsize(sess["path"])
        age = time.time() - os.path.getmtime(sess["path"])
    except OSError:
        return {"state": "gone", "age": None, "last": ""}

    with open(sess["path"], "rb") as fh:
        if size > tail_bytes:
            fh.seek(size - tail_bytes)
            fh.readline()                      # discard the partial first line
        chunk = fh.read()

    rows = []
    for raw in chunk.splitlines():
        rows.extend(rows_for(raw.decode("utf-8", "replace"), sess["kind"]))

    last = rows[-1] if rows else None
    if age > IDLE_AFTER:
        state = "idle"
    elif last is None:
        state = "idle"
    elif last["cls"] == "assistant":
        state = "waiting"                      # turn handed back to you
    else:
        state = "working"                      # mid tool call, or you just sent

    # The most recent thing either of you actually said, which is more useful
    # on a card than whatever tool happened to run last.
    said = [r for r in rows if r["cls"] in ("assistant", "user")]
    snippet = (said[-1]["text"] if said else "").strip().replace("\n", " ")
    return {"state": state, "age": int(age), "last": snippet[:120]}


def overview():
    out = []
    for p in list_panes():
        # agent_id, not id: `id` is the pane id the UI selects with, and
        # overwriting it with the session id makes every card unselectable.
        row = dict(p, kind=None, agent_id=None, state=None, age=None,
                   last="", prompt=None)
        sess = pane_session(p["id"])
        if sess:
            row["kind"], row["agent_id"] = sess["kind"], sess["id"]
            row.update(session_status(sess))
        # Checked for every pane, not just resolved agents: anything can stop
        # to ask. And it overrides the transcript-derived state, which would
        # otherwise report "working" for a pane that is blocked -- the worst
        # thing to get wrong on a dashboard whose job is "who needs me".
        prompt = pane_prompt(p["id"])
        if prompt:
            row["prompt"], row["state"] = prompt, "blocked"
        out.append(row)
    # Blocked first, then agents by recency, plain shells last.
    out.sort(key=lambda r: (r["state"] != "blocked", r["kind"] is None,
                            r["age"] if r["age"] is not None else 1 << 30))
    return out


# Only these may be spawned. This endpoint starts processes, so the agent name
# is matched against a list rather than interpolated from the request.
AGENTS = {"claude": "claude", "codex": "codex"}


def session_name_for(path):
    """Mirror the ftz/ftn convention: basename with dots replaced, or the
    session_name from .tmux.yaml when the project defines one."""
    name = os.path.basename(path.rstrip("/")) or "root"
    yaml_path = os.path.join(path, ".tmux.yaml")
    try:
        with open(yaml_path) as fh:
            for line in fh:
                if line.startswith("session_name:"):
                    name = line.split(":", 1)[1].strip() or name
                    break
    except OSError:
        pass
    return name.replace(".", "_")


def live_sessions():
    return set(tmux("list-sessions", "-F", "#{session_name}").split())


# --------------------------------------------------------- finding projects
# The candidate list used to come from a separate directory-frecency tool,
# which a first-time user had neither installed nor trained -- so "+ new
# agent" did nothing at all until they had learned about and populated a
# second program. It walks the filesystem itself now. The whole design
# problem is that this happens while someone types on a phone, so every part
# of the walk is bounded and the bounds are the interesting behaviour.

# Where to look. Colon separated, ~ expanded. A root is scanned whatever it is
# called, which is also the escape hatch for a directory the exclusions below
# would otherwise hide.
PROJECT_ROOTS = [os.path.expanduser(p)
                 for p in _env("PROJECT_ROOTS", "~").split(":") if p.strip()]
# How far below a root a project may sit. Six covers ~/src/org/repo/sub and
# stops well short of the leaves of a source tree.
PROJECT_DEPTH = int(_env("PROJECT_DEPTH", "6"))
# Wall clock one walk may spend. It runs on a worker thread, so this bounds
# the work rather than the response.
PROJECT_BUDGET = float(_env("PROJECT_BUDGET", "4"))
# Wall clock a request may wait for that walk before answering with whatever
# has arrived. This is the number that keeps the request loop moving.
PROJECT_WAIT = float(_env("PROJECT_WAIT", "0.4"))
# How long a completed search stays usable, and how long a directory listing
# is trusted. Short enough that a repo cloned a minute ago shows up.
PROJECT_TTL = float(_env("PROJECT_TTL", "60"))

# Directories that are never a project and never contain one. Every name here
# is a decision, so the set is explicit rather than a clever heuristic:
# dependency trees and build output, caches and trash, virtualenvs, and the
# platform's own folders. Extend it on one machine with
# AYEAYE_PROJECT_SKIP=name,name -- names, matched exactly, not paths.
PROJECT_SKIP = set("""
    node_modules bower_components jspm_packages vendor Godeps
    target build dist out obj Debug Release
    site-packages dist-packages __pycache__ eggs venv virtualenv env
    Library Applications System Volumes AppData
    Trash trash tmp temp cache Caches
    snap flatpak
""".split()) | set(n for n in
                   (s.strip() for s in _env("PROJECT_SKIP").split(",")) if n)


def _project_skip(name):
    """True for a directory the walk must neither return nor enter.

    Leading dot covers the whole class the exclusion list cannot enumerate:
    tool and application internals, .venv and .tox and .cache and .git and
    every dotfile directory a package manager will invent next year.
    """
    return (name.startswith(".")
            or name in PROJECT_SKIP
            or name.endswith(".egg-info"))


# Listing the same directory once per keystroke is what would make searching
# while typing unaffordable, so listings are memoised for PROJECT_TTL. The
# cache is bounded by clearing it wholesale: an eviction policy would be more
# code than the walk it serves, and refilling costs one bounded walk.
_LIST_MAX = 4000               # directories remembered
_PER_DIR_MAX = 5000            # entries examined in any one of them
_list_cache = {}
_list_lock = threading.Lock()


def _list_dir(path):
    """Interesting sub-directories of `path`, as (path, is_git).

    Symlinked directories are skipped outright. A symlink is either a second
    name for something the walk will reach anyway or a way out of the bounded
    region entirely, and following one is how a walk finds a cycle.

    Only the first _PER_DIR_MAX entries are examined. Every other bound in
    the search is checked between directories, which is no help at all inside
    a single one holding a hundred thousand children -- a package cache, a
    maildir, a downloads folder someone never emptied. Truncating there is
    what keeps the clock and the cancel flag reachable.
    """
    now = time.monotonic()
    with _list_lock:
        hit = _list_cache.get(path)
    if hit and now - hit[0] < PROJECT_TTL:
        return hit[1]
    rows = []
    try:
        with os.scandir(path) as entries:
            examined = 0
            for entry in entries:
                examined += 1
                if examined > _PER_DIR_MAX:
                    break
                if _project_skip(entry.name):
                    continue
                try:
                    if not entry.is_dir(follow_symlinks=False):
                        continue
                except OSError:
                    continue
                # A worktree and a submodule keep .git as a file rather than a
                # directory, and both are somewhere you would start an agent.
                rows.append((entry.path,
                             os.path.exists(os.path.join(entry.path, ".git"))))
    except OSError:
        rows = []
    with _list_lock:
        if len(_list_cache) >= _LIST_MAX:
            _list_cache.clear()
        _list_cache[path] = (now, rows)
    return rows


def walk_projects(query="", limit=0, roots=None, depth=None, deadline=None,
                  cancel=None, out=None):
    """Directories under `roots` whose path contains `query`, breadth first.

    Returns (rows, stopped), where a row is (path, is_git, level) and stopped
    names the bound that ended the walk -- "depth", "deadline", "cancel",
    "limit", or "" when the tree was exhausted. Callers care which: a walk
    that finished is worth caching and one that was cut short is not.

    Pass `out` to be given the results as they are found rather than at the
    end. That is what lets a request answer from a walk still in progress:
    appending to a list is atomic, so a reader taking a copy of it always
    sees a coherent prefix of the answer.

    Breadth first because a project sits a couple of levels below home, so
    the answers worth having arrive before any bound can bite. Bounds are
    checked before each directory is listed; the case that check cannot
    cover -- one directory with a hundred thousand entries -- is bounded
    inside _list_dir instead. `limit` of 0 means no early stop.
    """
    roots = PROJECT_ROOTS if roots is None else roots
    depth = PROJECT_DEPTH if depth is None else depth
    q = query.strip().lower()
    rows, stopped = ([] if out is None else out), ""
    frontier = [(os.path.abspath(r), 0) for r in roots if os.path.isdir(r)]
    seen = set(p for p, _ in frontier)
    while frontier:
        nxt = []
        for path, level in frontier:
            if cancel is not None and cancel.is_set():
                return rows, "cancel"
            if deadline is not None and time.monotonic() >= deadline:
                return rows, "deadline"
            if level >= depth:
                stopped = "depth"
                continue
            for child, is_git in _list_dir(path):
                if child in seen:
                    continue
                seen.add(child)
                if not q or q in child.lower():
                    rows.append((child, is_git, level + 1))
                    if limit and len(rows) >= limit:
                        return rows, "limit"
                nxt.append((child, level + 1))
        frontier = nxt
    return rows, stopped


# ------------------------------------------------------------- pick history
# What the old frecency tool was really providing was not a directory list --
# the filesystem already has one -- but a record of which directories you
# actually use. So AyeAye keeps that record itself, in its own state
# directory, updated whenever an agent is started somewhere. No second tool
# and nothing to train: the picker gets better because you used it.
_RECENTS_FILE = os.path.join(_state_dir(), "projects.json")
_RECENTS_MAX = 200             # a ranking signal, not a history file
_RECENTS_HALF_LIFE = 14.0      # days before a pick counts for half
_recents_lock = threading.Lock()


def _recents_load():
    """{path: (count, last_used)}.

    Anything wrong with the file -- absent, unreadable, truncated by a crash,
    hand-edited into nonsense -- means no ranking signal rather than an
    error. A picker without history is still a working picker, and this is
    called on the request path.
    """
    try:
        with open(_RECENTS_FILE) as fh:
            picks = json.load(fh).get("picks")
    except (OSError, ValueError, AttributeError):
        return {}
    if not isinstance(picks, dict):
        return {}
    out = {}
    for path, rec in picks.items():
        try:
            out[path] = (int(rec["n"]), float(rec["t"]))
        except (TypeError, ValueError, KeyError, IndexError):
            continue
    return out


def _recent_score(rec, now):
    """Frecency: how often, discounted by how long ago.

    Halving every fortnight is what makes this a record of what you are
    working on rather than what you once worked on -- a directory opened
    three times this week beats one opened ten times last spring.
    """
    if not rec:
        return 0.0
    count, last = rec
    age_days = max(0.0, (now - last) / 86400.0)
    return count * (0.5 ** (age_days / _RECENTS_HALF_LIFE))


def _recents_key(path):
    return os.path.abspath(os.path.expanduser(path)).rstrip("/") or "/"


def note_project_pick(path):
    """Record that an agent was started here.

    Best effort in every direction: a store that cannot be written costs
    ranking quality and nothing else, so no failure here may reach the
    response. The write is atomic, because a store half-replaced by a crash
    would read as corrupt and silently throw the history away.
    """
    key = _recents_key(path)
    now = time.time()
    with _recents_lock:
        picks = _recents_load()
        picks[key] = (picks.get(key, (0, 0.0))[0] + 1, now)
        if len(picks) > _RECENTS_MAX:
            ranked = sorted(picks.items(),
                            key=lambda kv: -_recent_score(kv[1], now))
            picks = dict(ranked[:_RECENTS_MAX])
        blob = {"version": 1,
                "picks": {p: {"n": n, "t": t} for p, (n, t) in picks.items()}}
        tmp = _RECENTS_FILE + ".tmp"
        try:
            os.makedirs(os.path.dirname(_RECENTS_FILE), exist_ok=True)
            with open(tmp, "w") as fh:
                json.dump(blob, fh)
            os.replace(tmp, _RECENTS_FILE)
        except OSError:
            pass


class ProjectSearchSuperseded(Exception):
    """A newer query took this search over before it could answer."""


class _Search(object):
    """One walk, running on a thread of its own.

    Cancelling it stops the thread that is walking, not merely the one that
    is waiting -- a query the user has already typed past must stop costing
    syscalls, or every keystroke leaves another walk grinding away behind it.
    """

    def __init__(self, query, cap):
        self.query, self.cap = query, cap
        self.cancel = threading.Event()
        self.done = threading.Event()
        # Appended to by the walking thread and copied by whoever is waiting.
        # Both operations are atomic, so a waiter that gives up early still
        # gets a coherent prefix of the answer -- which is the entire reason
        # a request can be answered before the walk has finished.
        self.rows = []
        self.stopped = "pending"

    def run(self):
        global _search_current
        try:
            _rows, self.stopped = walk_projects(
                self.query, self.cap, out=self.rows,
                deadline=time.monotonic() + PROJECT_BUDGET,
                cancel=self.cancel)
        except Exception:
            self.stopped = "error"
        finally:
            self.done.set()
            with _search_lock:
                # Cached here rather than by whoever was waiting, because a
                # walk finishing after its waiter gave up is the ordinary
                # case on a cold cache. Throwing that result away would mean
                # the next keystroke starts again from nothing, forever.
                if self.stopped in ("", "depth", "limit"):
                    if len(_search_cache) > 64:
                        _search_cache.clear()
                    _search_cache[(self.query, self.cap)] = (time.monotonic(),
                                                             list(self.rows))
                if _search_current is self:
                    _search_current = None

    def start(self):
        threading.Thread(target=self.run, daemon=True).start()
        return self


_search_lock = threading.Lock()
_search_current = None      # the one walk in flight, if any
_search_cache = {}          # (query, cap) -> (time, rows), for a walk that finished


def project_rows(found, q, limit):
    """Rank candidates and shape them into what the picker renders.

    Git repositories first and everything else after: "does it contain a
    .git" is the strongest signal available that a directory is a project
    rather than a folder something was once unzipped into. Inside each tier
    the pick history decides, then a match on the name over one buried in the
    path, then the shallower path, then the path itself -- so two identical
    queries produce an identical list, which matters when the answer is
    repainted on every keystroke.
    """
    now = time.time()
    recents = _recents_load()
    home = os.path.expanduser("~").rstrip("/")
    found = list(found)
    seen = set(path for path, _git, _level in found)

    def shorten(path):
        # A path prefix, not a string prefix: /home/alexander is not inside
        # /home/alex. And an empty home -- HOME=/ -- shortens nothing, since
        # "~etc" helps nobody read where they are.
        if not home:
            return path
        if path == home:
            return "~"
        if path.startswith(home + os.sep):
            return "~" + path[len(home):]
        return path

    # Somewhere you have started an agent is a candidate even when the walk
    # cannot reach it: outside the roots, or below the depth bound. Only the
    # strongest handful are worth checking -- each costs two stats on the
    # request thread, and the rest could never reach the top of the list.
    strongest = sorted(recents, key=lambda p: -_recent_score(recents[p], now))
    for path in strongest[:50]:
        if path in seen or (q and q not in path.lower()):
            continue
        if not os.path.isdir(path):
            continue
        seen.add(path)
        found.append((path, os.path.exists(os.path.join(path, ".git")), 0))

    def rank(row):
        path, is_git, level = row
        return (not is_git,
                -_recent_score(recents.get(path), now),
                0 if q in os.path.basename(path).lower() else 1,
                level, path)

    live, rows = live_sessions(), []
    for path, is_git, _level in sorted(found, key=rank):
        if len(rows) >= limit:
            break
        name = session_name_for(path)
        rows.append({"dir": path, "short": shorten(path),
                     "session": name, "exists": name in live, "git": is_git})
    return rows


def projects(query="", limit=40):
    """Candidate project directories for the picker, best match first.

    The walk never runs on the calling thread. This is called from the HTTP
    handler while someone types, and a filesystem walk on a request thread
    would put the pane polls and the transcript stream behind it on the same
    connection. So the search runs elsewhere, this waits PROJECT_WAIT for it,
    and answers with whatever has arrived by then -- partial and immediate
    beats complete and late when the next keystroke is 150ms away.

    A different query supersedes the one before it: the older call abandons
    its wait at once and raises ProjectSearchSuperseded rather than racing
    the newer answer to the browser, and its walk is cancelled instead of
    left running. Two callers asking the *same* thing share one walk, so a
    second browser cannot starve the first.
    """
    global _search_current
    q = query.strip().lower()
    # Ranking wants more candidates than it returns, because the first
    # `limit` directories a breadth-first walk meets are not the best
    # `limit`. This is still an early stop, just not a myopic one.
    cap = max(limit * 8, 200)

    started = None
    with _search_lock:
        hit = _search_cache.get((q, cap))
        if hit and time.monotonic() - hit[0] < PROJECT_TTL:
            search, found = None, hit[1]
        else:
            current = _search_current
            if current is not None and (current.query, current.cap) == (q, cap):
                search = current           # already being walked; wait on it
            else:
                if current is not None:
                    current.cancel.set()
                search = _search_current = started = _Search(q, cap)

    if started is not None:
        started.start()

    if search is not None:
        # Waiting in slices, so that being superseded cuts the wait short
        # rather than merely changing the answer at the end of it.
        deadline = time.monotonic() + PROJECT_WAIT
        while not search.done.wait(0.02):
            if search.cancel.is_set() or time.monotonic() >= deadline:
                break
        # Cancelled means superseded, whether or not the walk has noticed yet.
        # Asking whether it had also finished would be a race: cancelling it
        # is precisely what makes it finish, a few milliseconds later.
        if search.cancel.is_set():
            raise ProjectSearchSuperseded(q)
        found = list(search.rows)

    return project_rows(found, q, limit)


# The board page reads the same cliban the terminal does, through its --json
# output rather than the SQLite file underneath, so list/show semantics
# (archival, ordering, relations) stay cliban's problem. Resolved at startup:
# the systemd user PATH does not include ~/.cargo/bin.
CLIBAN = (os.environ.get("VOICE_CLIBAN")
          or shutil.which("cliban")
          or os.path.expanduser("~/.cargo/bin/cliban"))
# Both land in a subprocess argv; a shape check keeps these endpoints from
# becoming a way to hand cliban arbitrary arguments.
ISSUE_KEY = re.compile(r"^[A-Za-z][A-Za-z0-9]*-\d+$")
PROJECT_KEY = re.compile(r"^[A-Za-z][A-Za-z0-9]*$")


def cliban(*args):
    """Run cliban, returning (stdout, error)."""
    try:
        p = subprocess.run((CLIBAN,) + args, capture_output=True,
                           text=True, timeout=15)
    except Exception as exc:
        return "", str(exc)
    if p.returncode != 0:
        return "", (p.stderr.strip() or "cliban exited %d" % p.returncode)
    return p.stdout, ""


def cliban_rows(*args):
    """NDJSON lines as a list of dicts."""
    out, err = cliban(*args)
    rows = []
    for line in out.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            rows.append(json.loads(line))
        except ValueError:
            pass
    return rows, err


def cliban_board():
    """Everything the board renders, in one payload.

    One fetch of all projects rather than per-project queries: the whole
    board is a couple hundred KB without descriptions, and filtering
    client-side means switching projects costs nothing on a phone.
    """
    projs, err = cliban_rows("project", "ls", "--json")
    if err:
        return {"error": err}
    milestones, _ = cliban_rows("milestone", "ls", "--json",
                                "--sort", "activity")
    issues, _ = cliban_rows("issue", "ls", "--json", "--sort", "position")
    return {"projects": projs, "milestones": milestones, "issues": issues}


def spawn_agent(path, agent, prompt=""):
    """Start an agent for a project, following the ftz session convention.

    An existing session for the project gets a new window rather than a new
    session, so everything for one project stays under one name.
    """
    cmd = AGENTS.get(agent)
    if not cmd:
        return {"error": "unknown agent"}
    if not os.path.isdir(path):
        return {"error": "no such directory"}
    name = session_name_for(path)

    if name in live_sessions():
        # "=" forces an exact match; tmux would otherwise resolve a prefix.
        pane = tmux("new-window", "-t", "=" + name, "-c", path,
                    "-P", "-F", "#{pane_id}").strip()
        created = "window"
    else:
        pane = tmux("new-session", "-d", "-s", name, "-c", path,
                    "-P", "-F", "#{pane_id}").strip()
        created = "session"
    if not pane:
        return {"error": "tmux would not create the %s" % created}

    if prompt:
        # Both agents take an opening prompt as an argument, which sidesteps
        # guessing how long the TUI takes to boot before pasting into it.
        # Collapsed to one line and shell-quoted: it is typed into the user's
        # shell, and fish concatenates adjacent quoted strings the same way
        # POSIX does, so shlex quoting survives there too.
        cmd = cmd + " " + shlex.quote(" ".join(prompt.split()))
    tmux("send-keys", "-t", pane, "-l", cmd)
    tmux("send-keys", "-t", pane, "Enter")

    # Starting an agent somewhere is the strongest possible signal that this
    # is one of your projects, so it is what teaches the picker.
    note_project_pick(path)

    return {"pane": pane, "session": name, "created": created, "agent": agent}




def notify(title, body, tags=("warning",), priority=4, click=""):
    """Publish to ntfy. Best effort -- a notification failure must never
    interfere with the app itself.

    Uses the JSON API rather than ntfy's header form: HTTP headers are
    latin-1, so a non-ASCII character in a title arrives mangled. Agent
    questions are full of them.
    """
    if not NTFY_URL:
        return
    base, _, topic = NTFY_URL.rstrip("/").rpartition("/")
    payload = {"topic": topic, "title": title, "message": body,
               "priority": priority, "tags": list(tags)}
    if click:
        payload["click"] = click
    req = urllib.request.Request(
        base + "/", data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"}, method="POST")
    try:
        urllib.request.urlopen(req, timeout=10).read()
    except Exception as exc:
        sys.stderr.write("notify failed: %s\n" % exc)


def watch_and_notify():
    """Fire once when an agent starts needing you, not repeatedly.

    Keyed on the pane plus the question, so a fresh prompt in the same pane
    notifies again while the same prompt sitting unanswered stays quiet.
    """
    seen = {}
    while True:
        time.sleep(NOTIFY_EVERY)
        try:
            rows = overview()
        except Exception:
            continue
        current = {}
        for r in rows:
            if r.get("state") not in NOTIFY_STATES:
                continue
            prompt = r.get("prompt") or {}
            question = prompt.get("question") or r.get("last") or ""
            key = (r["id"], question[:120])
            current[r["id"]] = key
            if seen.get(r["id"]) == key:
                continue                      # already told you about this one
            where = "%s:%s" % (r["session"], r["window"])
            agent = r.get("kind") or r.get("cmd") or "agent"
            opts = prompt.get("options") or []
            body = question[:300] or "is waiting for you"
            if opts:
                body += "\n\n" + "\n".join(
                    "%s. %s" % (o["key"], o["label"][:60]) for o in opts[:4])
            notify("%s · %s needs you" % (where, agent), body,
                   click=NTFY_CLICK)
        seen = current                        # drop panes that are no longer blocked


# ------------------------------------------------------------- voice probe
# Voice is a progressive enhancement, not a requirement. The floor is
# text-only: pane list, transcripts, prompt answering and typed input all
# work with no whisper, no ollama, no ffmpeg installed. The UI learns from
# /api/overview whether voice is worth offering and greys out the talk
# button when it is not.

VOICE_PROBE_TTL = float(os.environ.get("VOICE_PROBE_TTL", "30"))
_voice_probe = {"at": 0.0, "ok": False}


def voice_available():
    """Can /api/dictate plausibly succeed right now?

    Decoding needs ffmpeg; transcription needs the whisper server the
    dictation path uses, or its CLI fallback: the transcriber plus a model on
    disk. ollama is deliberately not probed -- polish() already degrades
    to the raw transcription without it. Cached for VOICE_PROBE_TTL seconds
    so the overview poll never pays for a connect per request; a benign race
    between threads costs at most one extra probe.

    The transcriber is not named here. It used to be, as the literal string
    `whisper-cpp`, and whisper.cpp has since renamed its binaries: its own
    builds, Homebrew's formula and Arch's package all install `whisper-cli`.
    A machine with that name and no server transcribes perfectly through
    bin/voice-dictate and was refused by this gate anyway, which is a talk
    button greyed out on a computer that can talk.

    So the question asked is the only one that means anything: is the command
    bin/voice-dictate is going to run actually there? vd.WHISPER_CLI is that
    command, resolved from VOICE_WHISPER_CLI or from the first of the names
    still in the world found on PATH. One name to keep in step instead of
    two, which is what went wrong the first time. shutil.which answers for an
    absolute path as readily as for a bare name, so a recorded path works.
    """
    now = time.time()
    if now - _voice_probe["at"] < VOICE_PROBE_TTL:
        return _voice_probe["ok"]
    ok = False
    if shutil.which("ffmpeg"):
        host, _, port = vd.WHISPER_SERVER.partition(":")
        try:
            with socket.create_connection((host, int(port or 8910)),
                                          timeout=1):
                ok = True
        except OSError:
            ok = bool(shutil.which(vd.WHISPER_CLI)
                      and os.path.exists(vd.WHISPER_MODEL))
    _voice_probe["at"], _voice_probe["ok"] = now, ok
    return ok


# SGR only: capture-pane -e emits colour/attribute codes, nothing cursor-y.
_SGR = re.compile(r"\x1b\[[0-9;:]*m")


def pane_view(pane_id, lines):
    """The pane as displayed: full visible screen plus `lines` of history,
    with colours, and the grid size so the client can render at the width
    tmux actually wrapped for.

    -e keeps the escapes; the browser turns them into styled spans. The whole
    capture is returned rather than the last N rows -- trimming decapitates a
    full-screen TUI, whose top box is as important as its bottom. Lines with
    escapes keep their trailing spaces: they may be painted background.
    """
    raw = tmux("capture-pane", "-p", "-e", "-t", pane_id, "-S", "-%d" % lines)
    kept = [ln if "\x1b" in ln else ln.rstrip() for ln in raw.splitlines()]
    while kept and not _SGR.sub("", kept[-1]).strip():
        kept.pop()
    size = tmux("display-message", "-p", "-t", pane_id,
                "#{pane_width}\t#{pane_height}").strip().split("\t")
    cols, rows = (int(size[0]), int(size[1])) \
        if len(size) == 2 and all(s.isdigit() for s in size) else (0, 0)
    return {"text": "\n".join(kept), "cols": cols, "rows": rows}


# ---------------------------------------------------------------- fit leases
# Auto-fit is a lease, not a latch. The client asks for the size it wants and
# the pane poll renews the lease as a side effect of watching; when the polls
# stop -- view switched, tab closed, phone locked -- the sweeper restores the
# window. So the browser dying abruptly can never leave the desktop stuck at
# phone width. The pre-fit state is captured once per lease: a window that
# was already sized manually goes back to that size, anything else goes back
# to automatic sizing.
FIT_TTL = float(_env("FIT_TTL", "12"))
_fits = {}                     # pane_id -> {"expires": t, "prev": tuple}
_fits_lock = threading.Lock()
# Leases survive a server restart on disk, so a crash mid-fit cannot strand
# a window at phone size: startup restores anything the file still lists,
# and a client that is still watching simply re-acquires on its next drift
# check.
_FITS_FILE = os.path.join(_state_dir(), "fits.json")


def _fits_save():
    with _fits_lock:
        snap = {p: list(st["prev"]) for p, st in _fits.items()}
    try:
        os.makedirs(os.path.dirname(_FITS_FILE), exist_ok=True)
        with open(_FITS_FILE, "w") as fh:
            json.dump(snap, fh)
    except OSError:
        pass


def fits_recover():
    """Restore windows a previous process left fitted, then start clean."""
    try:
        with open(_FITS_FILE) as fh:
            snap = json.load(fh)
    except (OSError, ValueError):
        return
    for pane, prev in snap.items():
        if isinstance(prev, list) and prev:
            _fit_restore(pane, tuple(prev))
    try:
        os.remove(_FITS_FILE)
    except OSError:
        pass


def _fit_prev(pane_id):
    opt = tmux("show-options", "-w", "-t", pane_id, "window-size").strip()
    if opt.split()[-1:] == ["manual"]:
        size = tmux("display-message", "-p", "-t", pane_id,
                    "#{window_width}\t#{window_height}").strip().split("\t")
        if len(size) == 2 and all(s.isdigit() for s in size):
            return ("manual", size[0], size[1])
    return ("auto",)


def _fit_restore(pane_id, prev):
    if prev[0] == "manual":
        tmux("resize-window", "-t", pane_id, "-x", prev[1], "-y", prev[2])
    else:
        tmux("set-option", "-w", "-t", pane_id, "-u", "window-size")


def fit_touch(pane_id):
    """Renew the lease as a side effect of the pane being watched."""
    with _fits_lock:
        if pane_id in _fits:
            _fits[pane_id]["expires"] = time.time() + FIT_TTL


def fit_acquire(pane_id):
    """Record the pre-fit state, once, before the first auto resize."""
    with _fits_lock:
        if pane_id in _fits:
            _fits[pane_id]["expires"] = time.time() + FIT_TTL
            return
    prev = _fit_prev(pane_id)              # tmux call outside the lock
    with _fits_lock:
        _fits.setdefault(pane_id, {"expires": time.time() + FIT_TTL,
                                   "prev": prev})
    _fits_save()


def fit_release(pane_id):
    with _fits_lock:
        st = _fits.pop(pane_id, None)
    if st:
        _fit_restore(pane_id, st["prev"])
        _fits_save()
    return bool(st)


def fit_sweeper():
    while True:
        time.sleep(2)
        now = time.time()
        with _fits_lock:
            due = [(p, st["prev"]) for p, st in _fits.items()
                   if st["expires"] < now]
            for p, _ in due:
                del _fits[p]
        for p, prev in due:
            _fit_restore(p, prev)
        if due:
            _fits_save()


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        # One line per POST -- those are the requests that act on panes.
        # GETs and the SSE stream stay quiet; the journal is noisy enough.
        if self.command != "POST":
            return
        sys.stderr.write("%s POST %s from %s auth=%s\n" % (
            time.strftime("%Y-%m-%dT%H:%M:%S"),
            self.path.split("?")[0],
            self.client_address[0],
            getattr(self, "_auth", "-")))

    # -- helpers ----------------------------------------------------------
    def _send(self, code, body, ctype, headers=None):
        if isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        for k, v in (headers or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    def _json(self, obj, code=200):
        self._send(code, json.dumps(obj), "application/json")

    def _query(self):
        return urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)

    def _body(self):
        return self.rfile.read(int(self.headers.get("Content-Length", 0) or 0))

    # -- request gates ----------------------------------------------------
    @staticmethod
    def _in_allowlist(host):
        host = (host or "").strip().lower()
        if host in ALLOWED_HOSTS:
            return True
        # Also match with the port stripped, so allowlisting a bare hostname
        # covers it on any port ([::1]:8911 keeps its brackets).
        bare = re.sub(r":\d+$", "", host)
        return bare != host and bare in ALLOWED_HOSTS

    def _host_ok(self):
        return self._in_allowlist(self.headers.get("Host"))

    def _origin_ok(self):
        """CSRF gate for POSTs. A browser always labels a cross-site request:
        either with Sec-Fetch-Site or with an Origin naming the other site."""
        if self.headers.get("Sec-Fetch-Site", "").strip().lower() == "cross-site":
            return False
        origin = self.headers.get("Origin", "").strip()
        if not origin:
            return True                    # non-browser client; auth still applies
        if origin.lower() == "null":
            return False
        try:
            netloc = urllib.parse.urlsplit(origin).netloc
        except ValueError:
            return False
        return self._in_allowlist(netloc)

    def _cookie_token(self):
        jar = http.cookies.SimpleCookie()
        try:
            jar.load(self.headers.get("Cookie", ""))
        except Exception:
            return ""
        tok = jar.get("voice_token")
        return tok.value if tok else ""

    def _authed(self):
        tok = self.headers.get("X-Voice-Token", "") or self._cookie_token()
        ok = bool(tok) and hmac.compare_digest(tok, TOKEN)
        self._auth = "ok" if ok else "fail"
        return ok

    def _forbidden(self):
        self.close_connection = True
        self._json({"error": "forbidden"}, 403)

    def _unauthorized(self):
        self.close_connection = True
        self._json({"error": "unauthorized"}, 401)

    def _login(self):
        """GET /login?token=…&next=/board (or /?token=…): set the auth cookie
        and bounce to next (a local path only; anything else becomes /). The
        user bookmarks the URL once; every later visit is clean."""
        tok = self._query().get("token", [""])[0]
        if not (tok and hmac.compare_digest(tok, TOKEN)):
            return self._unauthorized()
        nxt = self._query().get("next", ["/"])[0]
        if not nxt.startswith("/") or nxt.startswith("//") or "\\" in nxt:
            nxt = "/"
        cookie = ("voice_token=%s; Path=/; Max-Age=31536000; "
                  "HttpOnly; SameSite=Strict" % TOKEN)
        self._send(303, b"", "text/plain",
                   {"Location": nxt, "Set-Cookie": cookie})

    # -- routes -----------------------------------------------------------
    def handle_one_request(self):
        # Without this an unhandled error closes the socket with no response at
        # all, which reads client-side as a hang rather than a failure.
        try:
            BaseHTTPRequestHandler.handle_one_request(self)
        except Exception as exc:
            try:
                self._json({"error": "%s: %s" % (type(exc).__name__, exc)}, 500)
            except Exception:
                pass

    def do_GET(self):
        path = urllib.parse.urlparse(self.path).path
        if not self._host_ok():
            return self._forbidden()
        # The pages themselves are served without auth (they contain no
        # secrets and no data); every /api/* call they make is what is gated.
        if path == "/login" or (path in ("/", "/index.html")
                                and "token" in self._query()):
            return self._login()
        if path.startswith("/api/") and not self._authed():
            return self._unauthorized()
        if path in ("/", "/index.html"):
            try:
                with open(APP_HTML, "rb") as fh:
                    return self._send(200, fh.read(), "text/html; charset=utf-8")
            except OSError:
                return self._send(500, "app.html missing at " + APP_HTML,
                                  "text/plain")
        if path in ("/board", "/board.html"):
            try:
                with open(BOARD_HTML, "rb") as fh:
                    return self._send(200, fh.read(), "text/html; charset=utf-8")
            except OSError:
                return self._send(500, "board.html missing at " + BOARD_HTML,
                                  "text/plain")
        # Static, data-free, and needed before login: the manifest makes
        # "add to home screen" install a named, icon'd app.
        if path == "/manifest.webmanifest":
            try:
                with open(MANIFEST, "rb") as fh:
                    return self._send(200, fh.read(),
                                      "application/manifest+json")
            except OSError:
                return self._json({"error": "not found"}, 404)
        if path == "/icon.svg":
            try:
                with open(ICON_SVG, "rb") as fh:
                    return self._send(200, fh.read(), "image/svg+xml")
            except OSError:
                return self._json({"error": "not found"}, 404)
        if path == "/api/cliban/projects":
            # Just the keys, so the main page can linkify ticket references
            # without pulling the whole board. Degrades to no links (empty
            # list) rather than erroring when cliban is absent.
            projs, err = cliban_rows("project", "ls", "--json")
            return self._json({"keys": [p["key"] for p in projs
                                        if p.get("key")]})

        if path == "/api/cliban/board":
            board = cliban_board()
            return self._json(board, 500 if board.get("error") else 200)

        if path == "/api/cliban/issue":
            key = self._query().get("key", [""])[0]
            if not ISSUE_KEY.match(key):
                return self._json({"error": "bad key"}, 400)
            out, err = cliban("issue", "show", key, "--json")
            if err:
                return self._json({"error": err}, 500)
            try:
                return self._json(json.loads(out))
            except ValueError:
                return self._json({"error": "unreadable cliban output"}, 500)

        if path == "/api/panes":
            return self._json({"host": HOST_NAME, "panes": list_panes()})

        if path == "/api/overview":
            return self._json({"host": HOST_NAME,
                               "panes": overview(),
                               "voice": voice_available()})

        if path == "/api/projects":
            q = self._query().get("q", [""])[0]
            try:
                return self._json({"projects": projects(q)})
            except ProjectSearchSuperseded:
                # Distinguishable from an honest empty result on purpose: the
                # page must leave its list alone rather than repaint it with
                # "nothing matching" for a question already moved on from.
                return self._json({"projects": [], "superseded": True})
        if path == "/api/pane":
            pane = self._query().get("id", [""])[0]
            if not pane:
                return self._json({"error": "no pane"}, 400)
            fit_touch(pane)
            return self._json(pane_view(pane, PANE_LINES))

        if path == "/api/prompt":
            # One capture-pane, nothing else: cheap enough for the transcript
            # view to poll so a permission prompt is answerable from there
            # without paying for a full overview scan.
            pane = self._query().get("pane", [""])[0]
            if not pane:
                return self._json({"error": "no pane"}, 400)
            return self._json({"prompt": pane_prompt(pane)})

        if path == "/api/session":
            pane = self._query().get("pane", [""])[0]
            sess = pane_session(pane) if pane else None
            if not sess:
                return self._json({"kind": None})
            return self._json({"kind": sess["kind"], "id": sess["id"]})

        if path == "/api/stream":
            pane = self._query().get("pane", [""])[0]
            sess = pane_session(pane) if pane else None
            if not sess:
                return self._json({"kind": None}, 404)
            # No Content-Length: the body ends when the connection does, which
            # is what an event stream wants.
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache")
            self.send_header("X-Accel-Buffering", "no")   # never buffer a stream
            self.send_header("Connection", "close")
            self.end_headers()
            self.close_connection = True
            try:
                stream_transcript(self.wfile, sess)
            except (BrokenPipeError, ConnectionResetError):
                pass          # client navigated away; normal
            return

        return self._json({"error": "not found"}, 404)

    def do_POST(self):
        path = urllib.parse.urlparse(self.path).path
        self._auth = "-"
        if not self._host_ok() or not self._origin_ok():
            return self._forbidden()
        if not self._authed():
            return self._unauthorized()
        # Cap the body before reading it. Rejected early the unread bytes
        # would be parsed as the next request, so drop the connection too.
        limit = MAX_AUDIO_BODY if path == "/api/dictate" else MAX_BODY
        if int(self.headers.get("Content-Length", 0) or 0) > limit:
            self.close_connection = True
            return self._json({"error": "body too large"}, 413)

        if path == "/api/dictate":
            # Text-only servers refuse audio up front with a clear 503
            # rather than failing partway down the pipeline.
            if not voice_available():
                return self._json(
                    {"error": "voice not configured on this server"}, 503)
            pane = self._query().get("pane", [""])[0]
            ext = self._query().get("ext", ["webm"])[0]
            if ext not in AUDIO_EXTS:
                return self._json({"error": "bad ext"}, 400)
            audio = self._body()
            if not audio:
                return self._json({"error": "no audio"}, 400)
            pcm = vd.to_wav(audio, ext)
            if pcm is None:
                vd.log_event(device="remote", outcome="decode_failed",
                             bytes=len(audio), ext=ext)
                return self._json({"error": "could not decode audio"}, 400)
            rms = round(vd.rms_of_pcm(pcm), 1)
            seconds = round((len(pcm) - 44) / 32000.0, 1)
            if rms < vd.SILENCE_RMS:
                vd.log_event(device="remote", outcome="silence",
                             rms=rms, seconds=seconds)
                return self._json({"error": "that sounded like silence",
                                   "rms": rms}, 200)
            raw = vd.transcribe_pcm(pcm)
            if not raw:
                vd.log_event(device="remote", outcome="empty",
                             rms=rms, seconds=seconds)
                return self._json({"error": "nothing recognised"}, 200)
            names = vd.pane_vocabulary(pane) if pane else ""
            final = vd.polish(raw, names)
            vd.log_event(device="remote", outcome="ok", rms=rms,
                         seconds=seconds, raw=raw, final=final,
                         changed=(raw != final))
            return self._json({"raw": raw, "final": final})

        if path == "/api/answer":
            try:
                req = json.loads(self._body() or b"{}")
            except Exception:
                return self._json({"error": "bad json"}, 400)
            pane, key = req.get("pane", ""), str(req.get("key", ""))
            if not pane:
                return self._json({"error": "no pane"}, 400)
            res = answer_prompt(pane, key)
            return self._json(res, 400 if res.get("error") else 200)

        if path == "/api/spawn":
            try:
                req = json.loads(self._body() or b"{}")
            except Exception:
                return self._json({"error": "bad json"}, 400)
            res = spawn_agent(req.get("dir", ""), req.get("agent", ""),
                              str(req.get("prompt") or "")[:4000])
            return self._json(res, 400 if res.get("error") else 200)

        if path == "/api/resize":
            # tmux keeps one grid per pane, so the phone and the desktop
            # cannot each get their own width -- resizing here reflows the
            # window for every attached client. The agent TUIs reflow
            # cleanly, so with `auto` the page holds the fit as a lease (see
            # fit_sweeper) and the desktop gets its window back the moment
            # the phone stops watching. resize-window flips the window to
            # `window-size manual`; restore unsets the option and tmux
            # immediately recomputes from the attached clients.
            try:
                req = json.loads(self._body() or b"{}")
            except Exception:
                return self._json({"error": "bad json"}, 400)
            pane = req.get("pane", "")
            if not pane:
                return self._json({"error": "no pane"}, 400)
            if req.get("release"):
                # End an auto-fit lease: back to the recorded pre-fit state.
                return self._json({"ok": True, "restored": fit_release(pane)})
            if req.get("restore"):
                # Manual escape hatch: drop any lease and hand sizing back to
                # tmux outright, whatever the window was before.
                with _fits_lock:
                    _fits.pop(pane, None)
                _fits_save()
                tmux("set-option", "-w", "-t", pane, "-u", "window-size")
                return self._json({"ok": True, "restored": True})
            try:
                cols = max(20, min(400, int(req.get("cols", 0))))
                rows = max(5, min(200, int(req.get("rows", 0))))
            except (TypeError, ValueError):
                return self._json({"error": "bad size"}, 400)
            if req.get("auto"):
                # Capture the pre-fit state before the resize changes it.
                fit_acquire(pane)
            tmux("resize-window", "-t", pane, "-x", str(cols), "-y", str(rows))
            return self._json({"ok": True, "cols": cols, "rows": rows})

        if path == "/api/send":
            try:
                req = json.loads(self._body() or b"{}")
            except Exception:
                return self._json({"error": "bad json"}, 400)
            pane, text = req.get("pane", ""), req.get("text", "")
            if not pane or not text:
                return self._json({"error": "pane and text required"}, 400)
            # -l is literal, so nothing in the text is read as a key name.
            tmux("send-keys", "-t", pane, "-l", "--", text)
            if req.get("enter"):
                # Codex's composer swallows an Enter that arrives in the same
                # input burst as the text -- it reads as a newline rather than
                # submit, so the message just sits there. Claude tolerates it;
                # a short gap makes both behave.
                time.sleep(SEND_ENTER_DELAY)
                tmux("send-keys", "-t", pane, "Enter")
            return self._json({"ok": True})

        return self._json({"error": "not found"}, 404)


def main():
    if not os.path.exists(APP_HTML):
        sys.exit("missing UI at %s" % APP_HTML)
    fits_recover()
    threading.Thread(target=fit_sweeper, daemon=True).start()
    if NTFY_URL:
        threading.Thread(target=watch_and_notify, daemon=True).start()
        sys.stderr.write("notifying %s on %s\n"
                         % (NTFY_URL, ",".join(sorted(NOTIFY_STATES))))
    sys.stderr.write("ayeaye on %s:%d · token auth on, browsers "
                     "log in once via /?token=<token>\n" % (BIND, PORT))
    sys.stderr.write("voice: %s\n" % (
        "available" if voice_available()
        else "not configured; running text-only (re-probed every %ds)"
             % int(VOICE_PROBE_TTL)))
    ThreadingHTTPServer((BIND, PORT), Handler).serve_forever()


if __name__ == "__main__":
    main()
