#!/usr/bin/env python3
"""Voice dictation as a tmux state, toggled by one key.

    M-v  ->  starts recording, status bar shows ● REC
    M-v  ->  stops, transcribes, polishes, types it into the pane

Recording happens on whichever device your tmux client is SSH'd in from,
transcription and cleanup happen here on the GPU. Nothing is ever submitted:
the text is typed without Enter so you review it first.

There is deliberately no popup. A popup has to own the terminal to read a
keystroke, and that fought everything -- mouse reporting delivered escape
sequences that read as "cancel", and toggling cbreak mode per keypress lost
input entirely. Holding the state in tmux instead means nothing to close and
no keyboard to capture.

Usage (from a tmux binding):
    voice-dictate <pane_id> [client_pid]
"""
import array
import http.client
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_file_location


def _load_sibling(name, filename):
    """A python file next to this command, loaded as a module.

    Loaded rather than imported because bin/ holds commands: they have no .py
    extension, they are not on any import path, and there is no package here
    and no intention of adding one. The same few lines appear in bin/ayeaye;
    that is the price of having no package, and it is cheaper than the
    packaging that would remove it.

    realpath, not abspath. The tmux binding runs this off PATH, and the way it
    gets onto PATH is a symlink -- abspath would resolve "next to" as next to
    the symlink, where there is nothing. It would fail at import, and
    `run-shell -b` discards the traceback: the key would simply stop working.

    sys.modules is consulted first because bin/ayeaye loads this file and both
    of them load bin/process_inspect.py. Loading that twice would give the two
    of them separate class objects and a PROCESS_INFO each -- the same
    divergence the shared module exists to prevent, arriving one process later.

    Registered before it is executed, which is what lets a module load its own
    sibling, and removed again if the body raises -- otherwise the next caller
    is handed a half-built module instead of an error.
    """
    if name in sys.modules:
        return sys.modules[name]
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), filename)
    # The loader is named rather than inferred: importlib picks one from the
    # file extension, and a command deliberately has none.
    spec = spec_from_file_location(name, path,
                                   loader=SourceFileLoader(name, path))
    module = module_from_spec(spec)
    sys.modules[name] = module
    try:
        spec.loader.exec_module(module)
    except BaseException:
        del sys.modules[name]
        raise
    return module


def _load_env_file():
    """Fill os.environ from the install.sh config file; the real environment
    always wins. Same file systemd reads via EnvironmentFile=, so a tmux
    binding and a unit see identical configuration."""
    base = (os.environ.get("XDG_CONFIG_HOME")
            or os.path.expanduser("~/.config"))
    lines = None
    for name in ("ayeaye", "voice-remote"):     # new name first, legacy second
        try:
            with open(os.path.join(base, name, "env")) as fh:
                lines = fh.readlines()
            break
        except OSError:
            continue
    if lines is None:
        return
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        key, sep, val = line.partition("=")
        key = key.strip()
        if sep and key and key not in os.environ:
            os.environ[key] = val.strip().strip('"').strip("'")


_load_env_file()

WHISPER_SERVER = os.environ.get("VOICE_WHISPER_SERVER", "127.0.0.1:8910")
WHISPER_MODEL = os.environ.get(
    "VOICE_WHISPER_MODEL", os.path.expanduser("~/whisper-models/ggml-small.en.bin"))
WHISPER_THREADS = os.environ.get("VOICE_WHISPER_THREADS", "16")

# The command-line transcriber, for when the resident server is not up.
#
# Not a single hard-coded name any more. whisper.cpp renamed its binaries: the
# project's own builds and Homebrew's formula install `whisper-cli`, Arch's
# package installs `whisper-cli` too, and only older builds and some distro
# packages still carry `whisper-cpp`. Setup looks for any of them and records
# what it found, so the name checked here is the name that is really on this
# machine rather than the one that was current when this line was written.
# VOICE_WHISPER_CLI overrides, and an absolute path works.
WHISPER_CLI = os.environ.get("VOICE_WHISPER_CLI", "") or next(
    (name for name in ("whisper-cli", "whisper-cpp", "whisper")
     if shutil.which(name)), "whisper-cpp")
OLLAMA_MODEL = os.environ.get("VOICE_OLLAMA_MODEL", "qwen2.5:7b-instruct")
OLLAMA_HOST = os.environ.get("VOICE_OLLAMA_HOST", "localhost:11434")
KEEP_ALIVE = os.environ.get("VOICE_KEEP_ALIVE", "1h")
AGENT_PORT = int(os.environ.get("VOICE_PORT", "8787"))
TOKEN_PATH = os.path.expanduser("~/.config/voice-dictate/token")

STATE_DIR = os.environ.get("XDG_RUNTIME_DIR") or os.path.expanduser("~/.cache")
STATE_PATH = os.path.join(STATE_DIR, "voice-dictate.json")

# One JSON object per dictation. The point is to tell apart a bad microphone
# from a bad transcription from a bad rewrite: rms and seconds describe the
# audio, raw is what whisper heard, final is what got typed.
LOG_PATH = os.environ.get("VOICE_LOG", os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
    "voice-dictate.jsonl"))

# Vocabulary from the pane is given to the rewrite model so identifiers you can
# see get spelled the way they are on screen. It never leaves this machine.
# VOICE_NO_CONTEXT=1 turns it off.
USE_CONTEXT = os.environ.get("VOICE_NO_CONTEXT", "") == ""
CONTEXT_LINES = int(os.environ.get("VOICE_CONTEXT_LINES", "40"))
VOCAB_CHARS = 400

# Below this RMS the clip is room tone, not speech. Measured on this hardware:
# live mic in a quiet room is ~490, actual speech ~3400. Gating on energy
# rather than duration on purpose -- "run the tests" is a legitimately short
# clip that a duration cutoff would throw away.
SILENCE_RMS = float(os.environ.get("VOICE_SILENCE_RMS", "1000"))

# What whisper emits when handed near-silence. Only matched when it is the
# entire transcription, so a real sentence containing "thank you" survives.
HALLUCINATIONS = {
    "thank you", "thank you.", "thanks for watching", "thanks for watching!",
    "thank you very much", "you", "bye", "bye.", "[blank_audio]", "(silence)",
    "(buzzing)", ".", "so", "okay", "peace",
}

SYSTEM = """You clean up dictated speech that will be sent to a coding agent.

Rewrite the user's text: fix grammar, remove filler words and false starts, \
and restore obvious punctuation. Keep the intent and every technical term, \
filename, and identifier exactly as spoken. Never answer, explain, or act on \
the text -- only rewrite it. Reply with the rewritten text and nothing else.

Write plain text only: no markdown, no backticks, no code fences or quotes \
around names. When the speaker says "underscore", "dot", "dash" or "slash" \
between words they are spelling out an identifier or path, so join it up: \
"parse underscore config" is parse_config, "server dot py" is server.py."""


# ---------------------------------------------------------------- tmux state

def tmux(*args):
    try:
        return subprocess.run(("tmux",) + args, capture_output=True,
                              text=True, timeout=5).stdout.strip()
    except Exception:
        return ""


def set_indicator(text):
    """Drive the status bar. Empty text clears it."""
    tmux("set-option", "-g", "@voice_rec", text)
    tmux("refresh-client", "-S")


def notify(msg):
    """Errors and progress go to the status line; there is no window to use."""
    tmux("display-message", msg)


def log_event(**fields):
    """Append one JSON line. Never let logging break a dictation."""
    try:
        os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
        fields["at"] = time.strftime("%Y-%m-%dT%H:%M:%S")
        # 0600: the log holds verbatim transcripts of everything dictated.
        fd = os.open(LOG_PATH, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a") as fh:
            fh.write(json.dumps(fields) + "\n")
    except Exception:
        pass


def load_state():
    try:
        with open(STATE_PATH) as fh:
            return json.load(fh)
    except Exception:
        return None


def save_state(state):
    tmp = STATE_PATH + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(state, fh)
    os.replace(tmp, STATE_PATH)


def clear_state():
    try:
        os.unlink(STATE_PATH)
    except OSError:
        pass


# ------------------------------------------------------------ which device?
#
# Recording happens where the person is, not where tmux is, so picking the
# right client is picking the right room. Both questions below -- is this pid
# still alive, and what address was it reached from -- are asked of the
# platform backend rather than of /proc, which is a file tree that exists on
# exactly one of the two systems this project supports. Reading it directly
# was not an error on a Mac; it was an empty answer, which made every client
# look local and handed the microphone to whichever one tmux listed first.
process_inspect = _load_sibling("ayeaye_process_inspect", "process_inspect.py")

# Module-level so a test can put another platform's backend here, and read
# through the global on every call for the same reason. bin/ayeaye binds a
# name to the same object: replacing one of the two does not replace the
# other, which is what a test that wants both patched has to know.
PROCESS_INFO = process_inspect.PROCESS_INFO


def resolve_client_pid(pane_id, passed):
    """Prefer the pid tmux handed us; fall back to the pane's own session."""
    if passed and passed.isdigit() and PROCESS_INFO.exists(passed):
        return passed
    session = tmux("display-message", "-p", "-t", pane_id, "#{session_name}")
    clients = tmux("list-clients", "-t", session, "-F", "#{client_pid}").split()
    for pid in clients:                      # a remote client is the interesting one
        if client_peer_ip(pid):
            return pid
    return clients[0] if clients else None


def client_peer_ip(client_pid):
    """The IP the tmux client is connected from, or None if it's local."""
    return PROCESS_INFO.ssh_peer_ip(client_pid)


def tailscale_name(ip):
    try:
        raw = subprocess.run(["tailscale", "whois", "--json", ip],
                             capture_output=True, timeout=5, text=True)
        if raw.returncode == 0:
            name = json.loads(raw.stdout).get("Node", {}).get("Name", "")
            if name:
                return name.split(".")[0]
    except Exception:
        pass
    return ip


# --------------------------------------------------------------- pane vocab

# Things that look like code rather than English: they carry a _ . / - or an
# internal capital. Plain prose is left out so the hint stays dense.
CODEY = re.compile(r"[A-Za-z_~./][A-Za-z0-9_./~-]{2,}")


def looks_like_code(word):
    core = word.strip(".,:;()[]{}'\"")
    if len(core) < 3 or len(core) > 60:
        return False
    return ("_" in core or "/" in core or "-" in core
            or re.search(r"\w\.\w", core) is not None
            or re.search(r"[a-z][A-Z]", core) is not None)


def pane_vocabulary(pane_id):
    if not USE_CONTEXT:
        return ""
    raw = tmux("capture-pane", "-p", "-t", pane_id, "-S", "-%d" % CONTEXT_LINES)
    seen, vocab = set(), []
    for line in reversed(raw.splitlines()):   # newest first: most relevant
        for word in CODEY.findall(line):
            word = word.strip(".,:;()[]{}'\"")
            key = word.lower()
            if key in seen or not looks_like_code(word):
                continue
            seen.add(key)
            vocab.append(word)
    return " ".join(vocab)[:VOCAB_CHARS]


# ------------------------------------------------------------- recorder API

def token():
    try:
        with open(TOKEN_PATH) as fh:
            return fh.read().strip()
    except OSError:
        return None


def agent_call(host, method, path, tok, timeout=20):
    conn = http.client.HTTPConnection(host, AGENT_PORT, timeout=timeout)
    try:
        conn.request(method, path, headers={"X-Voice-Token": tok})
        resp = conn.getresponse()
        return resp.status, resp.read(), dict(resp.getheaders())
    finally:
        conn.close()


# ------------------------------------------------------ transcribe + polish

def rms_of_pcm(wav_bytes, stride=7):
    """Rough loudness of a 16-bit mono WAV. Strided so long clips stay cheap."""
    pcm = wav_bytes[44:]                       # skip the RIFF header
    samples = array.array("h")
    try:
        samples.frombytes(pcm[:len(pcm) // 2 * 2])
    except Exception:
        return 0.0
    sub = samples[::stride]
    if not sub:
        return 0.0
    return (sum(v * v for v in sub) / len(sub)) ** 0.5


def is_hallucination(text):
    """True for whisper's stock responses to silence."""
    return text.strip().lower().strip('."!,') in {
        h.strip('."!,') for h in HALLUCINATIONS}


def to_wav(audio, ext):
    """Normalise whatever the recorder sent to 16 kHz mono PCM. None on failure.

    Kept separate from transcription so the caller can measure the audio
    itself -- loudness and duration are what tell you whether a bad result
    came from the microphone or from the model.
    """
    with tempfile.TemporaryDirectory() as tmp:
        src = os.path.join(tmp, "clip." + ext)
        wav = os.path.join(tmp, "clip16k.wav")
        with open(src, "wb") as fh:
            fh.write(audio)
        try:
            conv = subprocess.run(
                ["ffmpeg", "-nostdin", "-loglevel", "error", "-i", src,
                 "-ac", "1", "-ar", "16000", "-y", wav],
                capture_output=True, text=True)
        except OSError:
            return None                    # no ffmpeg on this machine
        if conv.returncode != 0 or not os.path.exists(wav):
            return None
        with open(wav, "rb") as fh:
            return fh.read()


def transcribe_pcm(pcm):
    """16 kHz mono PCM -> text, or None if there's nothing worth typing."""
    # Resident server first: it holds large-v3 in VRAM, so a clip costs ~0.2s
    # instead of the ~2s the CLI spends reloading 2.9GB every time.
    text = server_transcribe(pcm)
    if text is None:
        # CLI fallback. Guarded so a missing binary or model degrades to
        # "nothing recognised" instead of a crash -- the rest of the app
        # must keep working without whisper.
        try:
            with tempfile.NamedTemporaryFile(suffix=".wav") as fh:
                fh.write(pcm)
                fh.flush()
                res = subprocess.run(
                    [WHISPER_CLI, "-m", WHISPER_MODEL, "-f", fh.name,
                     "-l", "en", "-nt", "-np", "-t", WHISPER_THREADS],
                    capture_output=True, text=True)
        except Exception:
            return None
        if res.returncode != 0:
            return None
        text = " ".join(res.stdout.split())

    # Backstop: a clip can clear the energy gate (a door, a cough) and still
    # transcribe to one of whisper's stock silence responses.
    if not text or is_hallucination(text):
        return None
    return text


def server_transcribe(wav_bytes):
    """POST to whisper-server. None if it isn't up, so the CLI can take over.

    No initial prompt is sent on purpose. Feeding it the pane vocabulary made
    transcription markedly worse -- whisper continues in the *style* of the
    prompt, so a list of identifiers turned "check why fetch user throws" into
    "check_wifetch_user_throwser". Spelling is fixed at the rewrite step
    instead, where it cannot corrupt words.
    """
    boundary = "----voicedictate7f3a2b"
    body = (
        ("--%s\r\nContent-Disposition: form-data; name=\"file\"; "
         "filename=\"clip.wav\"\r\nContent-Type: audio/wav\r\n\r\n"
         % boundary).encode() + wav_bytes +
        ("\r\n--%s\r\nContent-Disposition: form-data; "
         "name=\"response_format\"\r\n\r\njson\r\n--%s--\r\n"
         % (boundary, boundary)).encode())
    host, _, port = WHISPER_SERVER.partition(":")
    conn = http.client.HTTPConnection(host, int(port or 8910), timeout=30)
    try:
        conn.request("POST", "/inference", body=body, headers={
            "Content-Type": "multipart/form-data; boundary=" + boundary,
            "Content-Length": str(len(body))})
        resp = conn.getresponse()
        if resp.status != 200:
            return None
        return " ".join(json.loads(resp.read())["text"].split())
    except Exception:
        return None
    finally:
        conn.close()


def polish(text, names=""):
    """Best-effort cleanup. Any doubt about the result and we keep raw text.

    /api/chat, not /api/generate: given a flat completion prompt the instruct
    model continues the document and echoes the instructions back, which then
    gets typed into the pane.
    """
    system = SYSTEM
    if names:
        # A bare vocabulary list, not the screen text. Given prose the model
        # plagiarises it -- "run the parse config tests" came back as the full
        # pytest command that was on screen, plus a line number it invented.
        system += (
            "\n\nThese names appear on the user's screen. If the text contains "
            "something that sounds like one of them, spell it their way. Add "
            "nothing that the speaker did not say.\n<names>" + names + "</names>")
    payload = json.dumps({
        "model": OLLAMA_MODEL,
        "messages": [{"role": "system", "content": system},
                     {"role": "user", "content": text}],
        "stream": False,
        "options": {"temperature": 0.2},
        # ollama unloads after 5 minutes idle, and the reload costs ~3s --
        # fifteen times the actual work. Same reason whisper-server exists.
        # Costs ~4.7GB of VRAM held; VOICE_KEEP_ALIVE=5m to give it back.
        "keep_alive": KEEP_ALIVE,
    }).encode()
    host, _, port = OLLAMA_HOST.partition(":")
    conn = http.client.HTTPConnection(host, int(port or 11434), timeout=60)
    try:
        conn.request("POST", "/api/chat", body=payload,
                     headers={"Content-Type": "application/json"})
        resp = conn.getresponse()
        if resp.status != 200:
            return text
        result = json.loads(resp.read()).get("message", {}).get("content", "")
    except Exception:
        return text
    finally:
        conn.close()

    result = result.strip().strip('"').strip()
    if not result:
        return text
    lowered = result.lower()
    if any(m in lowered for m in ("rewrite the user", "filler word", "only rewrite")):
        return text
    # A cleanup pass is one line; multi-line means it answered the request.
    if "\n" in result:
        return text
    if len(result) > max(120, len(text) * 2):
        return text
    return result


# ------------------------------------------------------------------- toggle

def start(pane_id, client_pid, tok):
    peer = client_peer_ip(client_pid) if client_pid else None
    host, label = ("127.0.0.1", "local") if peer is None else (peer, tailscale_name(peer))

    try:
        status, body, _ = agent_call(host, "GET", "/health", tok, timeout=5)
    except Exception:
        return notify("voice: no recorder on %s -- run voice-agent there" % label)
    if status == 401:
        return notify("voice: %s rejected the token" % label)
    if status != 200 or not json.loads(body).get("ok"):
        return notify("voice: %s has no recording backend" % label)

    status, body, _ = agent_call(host, "POST", "/start", tok)
    if status != 200:
        return notify("voice: %s would not start recording" % label)

    save_state({"host": host, "label": label, "pane": pane_id, "at": time.time()})
    set_indicator("#[fg=#e46876,bold] ● REC #[default]")


def stop(state, tok):
    host, label, pane_id = state["host"], state["label"], state["pane"]
    clear_state()
    set_indicator("#[fg=#98bb6c,bold] … #[default]")
    held = round(time.time() - state.get("at", time.time()), 1)
    try:
        status, audio, headers = agent_call(host, "POST", "/stop", tok, timeout=30)
    except Exception as exc:
        set_indicator("")
        log_event(device=label, outcome="unreachable", error=str(exc)[:200])
        return notify("voice: lost contact with %s" % label)
    if status != 200:
        set_indicator("")
        log_event(device=label, outcome="record_failed", status=status)
        return notify("voice: recording failed on %s" % label)

    pcm = to_wav(audio, headers.get("X-Audio-Ext", "wav"))
    if pcm is None:
        set_indicator("")
        log_event(device=label, outcome="decode_failed",
                  bytes=len(audio), ext=headers.get("X-Audio-Ext"))
        return notify("voice: could not decode the audio")

    rms = round(rms_of_pcm(pcm), 1)
    seconds = round((len(pcm) - 44) / 32000.0, 1)
    common = dict(device=label, held=held, seconds=seconds, rms=rms)

    if rms < SILENCE_RMS:
        set_indicator("")
        log_event(outcome="silence", **common)
        return notify("voice: silence, nothing sent")

    t0 = time.time()
    raw = transcribe_pcm(pcm)
    t_asr = round(time.time() - t0, 2)
    if not raw:
        set_indicator("")
        log_event(outcome="empty", asr=t_asr, **common)
        return notify("voice: nothing recognised")

    t1 = time.time()
    final = polish(raw, pane_vocabulary(pane_id))
    t_llm = round(time.time() - t1, 2)
    set_indicator("")
    # -l is literal and no Enter is sent, so you review before submitting.
    tmux("send-keys", "-t", pane_id, "-l", "--", final)
    log_event(outcome="ok", asr=t_asr, llm=t_llm, raw=raw, final=final,
              changed=(raw != final), **common)


def main():
    if len(sys.argv) < 2:
        sys.exit("usage: voice-dictate <pane_id> [client_pid]")
    pane_id = sys.argv[1]
    tok = token()
    if tok is None:
        return notify("voice: no token -- run voice-dictate-setup")

    state = load_state()
    if state:
        stop(state, tok)
    else:
        start(pane_id, resolve_client_pid(pane_id, sys.argv[2] if len(sys.argv) > 2 else None), tok)


if __name__ == "__main__":
    main()
