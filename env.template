# voice-remote configuration. install.sh writes this file to
# ${XDG_CONFIG_HOME:-~/.config}/voice-remote/env and fills in the four
# prompted values; everything else ships commented out with its default.
#
# This is the one place to configure anything: the systemd user unit reads
# it via EnvironmentFile=, and the bin/ scripts read it directly when run by
# hand, so no setting ever requires editing a script or a unit file. A
# variable set in the real environment always wins over this file.
#
# Values are literal. No shell expansion happens (systemd does none either),
# so write absolute paths, never ~ or $HOME.

# ---------------------------------------------------------------- web app

# Address the web app binds. Loopback with `tailscale serve` in front is the
# safest choice; a tailnet IP works when a proxy on another machine must
# reach it. Never 0.0.0.0.
VOICE_REMOTE_BIND=@BIND@

# Port for the web app.
VOICE_REMOTE_PORT=@PORT@

# Hostnames the browser may reach the app through (the Host header your
# https front presents), comma separated. The bind address, localhost and
# 127.0.0.1 are always allowed; anything else, like your ts.net name or a
# reverse-proxy domain, must be listed here or requests get a 403.
VOICE_REMOTE_ALLOWED_HOSTS=@ALLOWED_HOSTS@

# Auth token for /api/*. Leave unset (recommended): one is generated with
# mode 0600 at $XDG_STATE_HOME/voice-remote/token on first run. Set it only
# if you manage the secret elsewhere.
#VOICE_REMOTE_TOKEN=

# Directory holding app.html and board.html. Defaults to the repo's share/
# directory next to bin/, or ~/.local/share/voice-remote when that exists.
#VOICE_REMOTE_SHARE=

# Pane lines shown in the terminal view.
#VOICE_REMOTE_LINES=24

# Name shown in the app header (the "host" field of /api/overview).
# Privacy: set it to mask your real hostname in screenshots and screen
# shares. Default: this machine's hostname.
#VOICE_REMOTE_NAME=

# Transcript entries sent when a client attaches.
#VOICE_TX_ROWS=200

# Seconds without transcript activity before an agent reads as idle.
#VOICE_IDLE_AFTER=300

# Gap in seconds between typing text into a pane and pressing Enter.
# Codex's composer swallows an Enter that arrives in the same burst.
#VOICE_SEND_DELAY=0.4

# Path to the cliban binary for /board. Found on PATH or at
# ~/.cargo/bin/cliban when unset. The board degrades to empty without it.
#VOICE_CLIBAN=

# ------------------------------------------- notifications (tier 2, optional)

# ntfy topic URL, e.g. http://127.0.0.1:2586/agents. Empty disables the
# watcher entirely; the app works without it, this only saves you from
# having to look.
VOICE_NTFY_URL=@NTFY_URL@

# URL opened when a notification is tapped: your https front for this app.
#VOICE_NTFY_CLICK=

# Seconds between checks for blocked agents.
#VOICE_NOTIFY_EVERY=10

# Which states notify, comma separated. "blocked" is an agent stopped at a
# prompt. Adding "waiting" fires after every completed turn, which is
# constant for an active agent.
#VOICE_NOTIFY_STATES=blocked

# --------------------------------------------------- voice (tier 3, optional)

# whisper.cpp server for transcription. Probed at runtime (cached
# VOICE_PROBE_TTL seconds); while unreachable the app runs text-only and
# the talk button greys out. Nothing fails.
#VOICE_WHISPER_SERVER=127.0.0.1:8910

# Seconds the voice probe result is cached.
#VOICE_PROBE_TTL=30

# CLI fallback when the server is down: whisper-cpp with this model.
# Absolute path to ggml weights.
#VOICE_WHISPER_MODEL=/home/you/whisper-models/ggml-small.en.bin

# Threads for the whisper-cpp CLI fallback.
#VOICE_WHISPER_THREADS=16

# ollama endpoint and model used to clean up dictation. Optional even
# within tier 3: unreachable ollama degrades to the raw transcription.
# Use an instruct model, not a coder model (a coder model answers the
# dictation instead of rewriting it).
#VOICE_OLLAMA_HOST=localhost:11434
#VOICE_OLLAMA_MODEL=qwen2.5:7b-instruct

# How long ollama holds the rewrite model in VRAM after a dictation.
#VOICE_KEEP_ALIVE=1h

# Below this RMS a clip is treated as room tone, not speech.
#VOICE_SILENCE_RMS=1000

# Set to any value to stop feeding on-screen identifiers to the rewrite
# model. The vocabulary never leaves this machine.
#VOICE_NO_CONTEXT=

# Pane lines scanned for that vocabulary.
#VOICE_CONTEXT_LINES=40

# Dictation log, one JSON object per clip, created 0600.
# Default: $XDG_STATE_HOME/voice-dictate.jsonl
#VOICE_LOG=

# -------------------------------- M-v recorder daemon (voice-agent, optional)
# These matter on the CLIENT device you SSH in from, not on the server.

# Address voice-agent binds. Loopback unless the tmux host must reach this
# device over the tailnet; then use this device's tailnet address. Never
# 0.0.0.0.
#VOICE_BIND=127.0.0.1

# Port voice-agent listens on, and the port voice-dictate calls.
#VOICE_PORT=8787

# Recording source for the ffmpeg backend (pulse device name, or an
# avfoundation spec like ":0" on macOS). Auto-detected when unset.
#VOICE_SOURCE=

# Hostname other devices use to reach the tmux host. voice-dictate-setup
# autodetects the tailscale name; set this to override it.
#VOICE_HOST=
